[Unit]
Description=Underwings nightly database backup (all containers, encrypted at rest)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=deployer
Group=deployer
WorkingDirectory=/home/deployer/underwings
ExecStart=/home/deployer/underwings/scripts/backup-databases.sh
StandardOutput=journal
StandardError=journal
TimeoutStartSec=600
# Don't restart on failure — the timer will catch the next run.
# Manual investigation expected via: journalctl -u backup-databases.service

[Install]
WantedBy=multi-user.target
