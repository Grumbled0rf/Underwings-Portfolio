---
// ===========================================
// CATEGORY HUB — Training & Awareness
// 2 flagship services + Y2 coming-soon roadmap
// ===========================================

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import '../../../styles/category-hub.css';

const flagship = [
  {
    slug: "security-awareness-training",
    title: "Security Awareness Training — Workshops",
    tagline: "Classroom or virtual workshops on phishing, social engineering, password, data handling. Live attack demos by the same team that runs the pen tests.",
    price: "AED 8,000 – 25,000",
    certs: ["CEH", "OSCP", "GRC Mastery"],
    lead: "Nelson Durairaj",
    hasPage: true,
    href: "/services/training-awareness/security-awareness-training",
  },
  {
    slug: "tabletop-incident-response",
    title: "Tabletop Incident Response Exercise",
    tagline: "1-day simulated cyber-incident drill with your team. Test the plan, surface the gaps, produce an improvement report. No tooling needed.",
    price: "AED 8,000 – 20,000",
    certs: ["CPTS", "ISO 27001 LA"],
    lead: "Manoj Prabhakaran",
    hasPage: true,
    href: "/services/training-awareness/tabletop-incident-response",
  },
];

const comingY2 = [
  { slug: "awareness-e-learning-platform", title: "Security Awareness E-Learning Platform", desc: "Our own self-serve LMS with per-seat annual licensing. Micro-lessons, phishing scores, compliance tracking. UAE-local content, Arabic support." },
  { slug: "role-specific-training-tracks", title: "Role-Specific Training Tracks", desc: "Targeted tracks for developers (secure coding), executives (board-level cyber), and finance teams (wire-fraud and social engineering)." },
];

const comingY3 = [];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://underwings.org" },
      { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://underwings.org/services" },
      { "@type": "ListItem", "position": 3, "name": "Training & Awareness", "item": "https://underwings.org/services/training-awareness" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Training & Awareness Services — Underwings",
    "itemListElement": flagship.map((s, i) => ({ "@type": "ListItem", "position": i + 1, "name": s.title }))
  }
];

export const prerender = false;
---

<Layout
  title="Security Awareness Training & Tabletop IR in UAE | Underwings"
  description="UAE security awareness workshops and tabletop incident response exercises that measurably stick. Live attack demos by OSCP-certified practitioners. HR + compliance friendly. Annual repeat buy."
  keywords="security awareness training UAE, tabletop incident response UAE, phishing awareness Dubai, cybersecurity training UAE, IR tabletop exercise"
  wfPage="services-page"
  schema={schema}
  bodyClass="body svc-compact"
>
  <Header currentPage="services" />

  <main id="main" class="main">

    <section class="section bottom-padding-clear top-padding-small">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab">
        <div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div>
      </div>
      <div class="container-medium">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">›</span>
          <a href="/services">Services</a>
          <span aria-hidden="true">›</span>
          <span class="crumbs-current">Training &amp; Awareness</span>
        </nav>

        <div class="hero">
          <div class="hero-main-wrapper">
            <div class="hero-heading-wrapper">
              <div class="label">
                <div class="text-small color-grey">Category — 2 flagship services</div>
              </div>
              <h1 class="heading-large hero-heading-large">Training &amp; Awareness — <span class="text-gradient-clip bg-color-green-gradient">That Actually Sticks</span></h1>
              <p class="text text-center" style="max-width:680px;margin:0 auto;">
                Workshops led by the same people who run the pen tests — because nobody explains why awareness matters better than someone who can demonstrate the attack in real time.
              </p>
            </div>
          </div>
        </div>

        <div class="cert-ribbon">
          <span class="cert-ribbon-label">Powered by</span>
          <span class="cert-chip">CEH</span>
          <span class="cert-chip">OSCP</span>
          <span class="cert-chip">CPTS</span>
          <span class="cert-chip">ISO 27001 LA</span>
          <span class="cert-chip">GRC Mastery</span>
        </div>
      </div>
    </section>

    <section class="section bg-color-dark">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab">
        <div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div>
      </div>
      <div class="container">
        <div class="section-wrapper-vertical section-wrapper-vertical-large">
          <div class="heading-horizontal">
            <div class="heading-horizontal-inner">
              <div class="heading-horizontal-left-part">
                <h2 class="heading">Flagship services — available now</h2>
              </div>
              <div class="heading-horizontal-right-part">
                <p class="text-medium">Workshops and tabletop exercises that pair well with phishing simulations for measurable behaviour change.</p>
              </div>
            </div>
          </div>

          <div class="flag-grid">
            {flagship.map((svc) => (
              <a href={svc.href} class="flag-card" aria-label={`Learn about ${svc.title}`}>
                <div class="flag-card-head">
                  <span class="flag-price">{svc.price}</span>
                  {svc.hasPage ? (
                    <span class="flag-badge flag-badge-ready">Full page</span>
                  ) : (
                    <span class="flag-badge flag-badge-contact">Contact to scope</span>
                  )}
                </div>
                <h3 class="flag-title">{svc.title}</h3>
                <p class="flag-tagline">{svc.tagline}</p>
                <div class="flag-card-foot">
                  <span class="flag-lead">Led by {svc.lead}</span>
                  <span class="flag-certs">{svc.certs.join(" · ")}</span>
                </div>
                <div class="flag-cta">
                  <span>{svc.hasPage ? "Read full details" : "Start a scoping call"}</span>
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab">
        <div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div>
      </div>
      <div class="container">
        <div class="section-wrapper-vertical section-wrapper-vertical-large">
          <div class="heading-horizontal">
            <div class="heading-horizontal-inner">
              <div class="heading-horizontal-left-part">
                <h2 class="heading">Year 2 — 2027 roadmap</h2>
              </div>
              <div class="heading-horizontal-right-part">
                <p class="text-medium">Productising awareness into a recurring-revenue platform.</p>
              </div>
            </div>
          </div>

          <div class="soon-grid">
            {comingY2.map((svc) => (
              <div class="soon-card" data-service-slug={svc.slug}>
                <div class="soon-card-head">
                  <span class="soon-badge soon-badge-2027">2027</span>
                </div>
                <h3 class="soon-title">{svc.title}</h3>
                <p class="soon-desc">{svc.desc}</p>
                <form class="soon-form" data-waitlist-form data-service-slug={svc.slug} data-service-year="2027">
                  <input type="email" name="email" placeholder="you@company.com" aria-label={`Email for ${svc.title} waitlist`} required />
                  <button type="submit" class="soon-btn">Add me to 2027 waitlist →</button>
                  <p class="soon-msg" aria-live="polite"></p>
                </form>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="section bg-color-dark">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab">
        <div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div>
      </div>
      <div class="container-medium">
        <div class="section-wrapper-vertical">
          <div class="heading-horizontal">
            <div class="heading-horizontal-inner">
              <div class="heading-horizontal-left-part">
                <h2 class="heading">Why this matters for UAE</h2>
              </div>
              <div class="heading-horizontal-right-part">
                <p class="text-medium">Annual slideshows don't change behaviour. Demonstrations do.</p>
              </div>
            </div>
          </div>
          <div class="why-uae-body">
            <p>Most UAE security awareness programmes are a <strong>once-a-year slideshow</strong> that employees click through without reading. Click rates stay high. Credentials still get phished. Wire fraud still lands.</p>
            <p>Ours isn't that. We demonstrate <strong>live attack techniques</strong> in the workshop — Wi-Fi spoofing, phishing kit walkthroughs, credential harvesting — and pair training with phishing simulations to measure real behaviour change over 90 days. The <strong>offensive team delivers the training</strong>, because the people who know how attacks work are the ones who can explain why defence matters.</p>
            <p>Clients pair workshops with our Phishing Simulation service to produce before/after click-rate reports that HR and compliance leaders can actually report to the board.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab">
        <div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div>
      </div>
      <div class="container-medium">
        <div class="section-wrapper-vertical" style="align-items:center;text-align:center;">
          <h2 class="heading" style="max-width:560px;">Tired of annual training that changes nothing?</h2>
          <p class="text-medium" style="max-width:580px;">
            Book a free 30-minute scoping call. Workshops can be scheduled within 2 weeks; tabletop exercises within 3. Written quote inside 48 hours.
          </p>
          <div class="button">
            <a href="/#contact?service=training-awareness" class="button-hidden w-button">Book a Free Scoping Call</a>
            <div class="button-wrapper">
              <div class="button-text">Book a Free Scoping Call</div>
            </div>
            <div class="button-accent-gradinet"></div>
          </div>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>

<script src="/js/waitlist.js" defer></script>
