---
// ============================================================
// SERVICE PAGE — Continuous Compliance Subscription
// Category: GRC (recurring service — flagship retention mechanism)
// ============================================================

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import '../../../styles/category-hub.css';
import '../../../styles/service-page.css';

const faqs = [
  { q: "Do we still need our own ISMS Manager?", a: "For larger organisations (200+ employees), yes — we complement, not replace. For under 50 employees, we typically suffice as your outsourced ISMS function." },
  { q: "What happens if we fail a surveillance audit?", a: "We don't let that happen — quarterly internal audits ensure no surprises. If a non-conformity arises during a real audit, remediation guidance is included at no extra cost." },
  { q: "Can we cancel?", a: "After the 12-month minimum, you can cancel with 30 days' notice. Before then, only with cause (e.g., we fail to deliver against the SLA)." },
  { q: "What's NOT included?", a: "New certification work, scope extensions to new frameworks, penetration tests, and training engagements are separate at standard rates — though subscribers receive priority scheduling on all of those." },
];

const schema = [
  { "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://underwings.org" },
    { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://underwings.org/services" },
    { "@type": "ListItem", "position": 3, "name": "Cybersecurity GRC", "item": "https://underwings.org/services/grc" },
    { "@type": "ListItem", "position": 4, "name": "Continuous Compliance Subscription", "item": "https://underwings.org/services/grc/continuous-compliance-subscription" }
  ]},
  { "@context": "https://schema.org", "@type": "Service", "name": "Continuous Compliance Subscription", "serviceType": "Compliance Maintenance Subscription",
    "provider": { "@type": "Organization", "name": "Underwings Cybersecurity Solutions", "url": "https://underwings.org" },
    "areaServed": { "@type": "Country", "name": "United Arab Emirates" },
    "offers": { "@type": "AggregateOffer", "priceCurrency": "AED", "lowPrice": "4000", "highPrice": "8000" },
    "description": "Monthly compliance maintenance for ISO 27001, ADHICS, NESA, and PDPL certified UAE organisations. Quarterly internal audits, evidence management, control monitoring, audit liaison.",
    "url": "https://underwings.org/services/grc/continuous-compliance-subscription"
  },
  { "@context": "https://schema.org", "@type": "FAQPage",
    "mainEntity": faqs.map(f => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } }))
  }
];

export const prerender = false;
---

<Layout
  title="Continuous Compliance Subscription UAE | Underwings"
  description="Monthly compliance subscription for ISO 27001, ADHICS, NESA, and PDPL-certified UAE organisations. Quarterly internal audits, evidence management, audit liaison. AED 4,000–8,000/month."
  keywords="continuous compliance UAE, ISO 27001 maintenance, ADHICS retainer, ISMS subscription Dubai, compliance retainer UAE"
  wfPage="services-page"
  schema={schema}
  bodyClass="body svc-compact"
>
  <Header currentPage="services" />

  <main id="main" class="main">

    <section class="section bottom-padding-clear top-padding-small">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"><div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div></div>
      <div class="container-medium">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><span aria-hidden="true">›</span>
          <a href="/services">Services</a><span aria-hidden="true">›</span>
          <a href="/services/grc">Cybersecurity GRC</a><span aria-hidden="true">›</span>
          <span class="crumbs-current">Continuous Compliance Subscription</span>
        </nav>

        <div class="svc-hero">
          <div class="label" style="justify-content:center;"><div class="text-small color-grey">GRC — Recurring Service · NEW</div></div>
          <h1 class="heading-large">Continuous Compliance Subscription — Stay Audit-Ready Year-Round</h1>
          <p class="text" style="max-width:720px;margin:1rem auto 0;">
            Once you're certified to <strong>ISO 27001, NESA / IA V2, ADHICS, or PDPL</strong>, the real work begins: keeping the certificate. We make that effortless.
          </p>

          <div class="svc-hero-badges">
            <span class="svc-hero-badge svc-hero-badge-price">AED 4,000 – 8,000 / month</span>
            <span class="svc-hero-badge svc-hero-badge-time">12-month minimum · cancel anytime after</span>
            <span class="svc-hero-badge svc-hero-badge-certs">ISO 27001 LA-led</span>
          </div>

          <div class="svc-hero-ctas">
            <div class="button">
              <a href="/#contact?service=continuous-compliance" class="button-hidden w-button">Book a 20-min scoping call →</a>
              <div class="button-wrapper"><div class="button-text">Book a 20-min scoping call →</div></div>
              <div class="button-accent-gradinet"></div>
            </div>
            <a href="#faq" class="svc-hero-cta-secondary">Jump to FAQ</a>
          </div>
        </div>
      </div>
    </section>

    <section class="section bg-color-dark">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"><div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div></div>
      <div class="container-medium">
        <h2 class="svc-sec-title">Who this is for</h2>
        <div class="svc-triggers">
          <div class="svc-trigger"><div class="svc-trigger-num">1</div><div>Companies who recently passed an <strong>ISO 27001, ADHICS, NESA / IA V2, or PDPL audit</strong>.</div></div>
          <div class="svc-trigger"><div class="svc-trigger-num">2</div><div>Organisations <strong>without a full-time ISMS manager or DPO</strong>.</div></div>
          <div class="svc-trigger"><div class="svc-trigger-num">3</div><div>Founders who want to focus on growth, not evidence collection.</div></div>
        </div>
      </div>
    </section>

    <section class="section">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"><div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div></div>
      <div class="container-medium">
        <h2 class="svc-sec-title">What's included</h2>
        <div class="ccs-grid">
          <div class="ccs-card">
            <h3 class="ccs-card-title">Quarterly Internal Audits</h3>
            <p class="ccs-card-body">Mini-audits every 90 days against your applicable framework. Catches drift before your annual surveillance audit.</p>
          </div>
          <div class="ccs-card">
            <h3 class="ccs-card-title">Evidence Management</h3>
            <p class="ccs-card-body">We maintain your evidence repository, control logs, and ISMS documentation. No more last-minute screenshot hunts before audits.</p>
          </div>
          <div class="ccs-card">
            <h3 class="ccs-card-title">Control Monitoring</h3>
            <p class="ccs-card-body">Monthly review of access logs, vendor risk register, incident records, and corrective action progress.</p>
          </div>
          <div class="ccs-card">
            <h3 class="ccs-card-title">Audit Liaison</h3>
            <p class="ccs-card-body">When your accredited certification body comes for surveillance, we sit in the room with you.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section bg-color-dark">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"><div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div></div>
      <div class="container-medium">
        <h2 class="svc-sec-title">What you get monthly</h2>
        <ul class="svc-deliv-list">
          <li class="svc-deliv-item"><svg class="svc-deliv-ico" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8l3 3 7-7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg><div><strong>Up to 4 hours</strong> of senior consultant time per month (ISO 27001 LA-led).</div></li>
          <li class="svc-deliv-item"><svg class="svc-deliv-ico" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8l3 3 7-7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg><div><strong>Updated evidence repository</strong> — kept current as your environment changes.</div></li>
          <li class="svc-deliv-item"><svg class="svc-deliv-ico" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8l3 3 7-7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg><div><strong>Monthly compliance dashboard</strong> — 1-page report covering posture, risks, actions.</div></li>
          <li class="svc-deliv-item"><svg class="svc-deliv-ico" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8l3 3 7-7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg><div><strong>Slack/Teams channel</strong> for ad-hoc compliance questions.</div></li>
          <li class="svc-deliv-item"><svg class="svc-deliv-ico" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8l3 3 7-7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg><div><strong>Same-day response on weekdays</strong> for compliance queries.</div></li>
        </ul>
      </div>
    </section>

    <section class="section">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"><div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div></div>
      <div class="container-medium">
        <h2 class="svc-sec-title">Three subscription tiers</h2>
        <div class="ccs-tier-grid">
          <div class="ccs-tier-card">
            <p class="ccs-tier-name">Lite</p>
            <p class="ccs-tier-price">AED 4,000<span class="ccs-tier-cycle">/month</span></p>
            <p class="ccs-tier-body">Single framework (ISO 27001 OR ADHICS OR PDPL), up to 50 employees.</p>
          </div>
          <div class="ccs-tier-card ccs-tier-card-popular">
            <span class="ccs-tier-badge">Most popular</span>
            <p class="ccs-tier-name">Standard</p>
            <p class="ccs-tier-price">AED 6,000<span class="ccs-tier-cycle">/month</span></p>
            <p class="ccs-tier-body">Single framework, 50–200 employees, OR two frameworks under 50 employees.</p>
          </div>
          <div class="ccs-tier-card">
            <p class="ccs-tier-name">Pro</p>
            <p class="ccs-tier-price">AED 8,000<span class="ccs-tier-cycle">/month</span></p>
            <p class="ccs-tier-body">Multi-framework (e.g., ISO 27001 + ADHICS + PDPL), up to 200 employees, plus quarterly risk register update.</p>
          </div>
        </div>
        <p class="ccs-tier-footnote">All tiers: 12-month minimum, monthly billing.</p>
      </div>
    </section>

    <section class="section bg-color-dark">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"><div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div></div>
      <div class="container-medium">
        <h2 class="svc-sec-title">Subscriber benefits</h2>
        <div class="ccs-benefits">
          <div class="ccs-benefit"><strong>Priority scheduling</strong><span>on penetration tests and training engagements</span></div>
          <div class="ccs-benefit"><strong>First access</strong><span>to new service offerings as we launch them</span></div>
          <div class="ccs-benefit"><strong>Dedicated senior practitioner</strong><span>relationship — same lead across the year</span></div>
        </div>
      </div>
    </section>

    <section class="section" id="faq">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"><div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div></div>
      <div class="container-medium">
        <h2 class="svc-sec-title">FAQ</h2>
        <div class="grc-faq-list">
          {faqs.map((f) => (
            <details class="grc-faq-item">
              <summary class="grc-faq-q">
                {f.q}
                <svg class="grc-faq-icon" width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 5l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </summary>
              <div class="grc-faq-a" set:html={f.a}></div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="section bg-color-dark">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"><div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div></div>
      <div class="container-medium">
        <div class="section-wrapper-vertical" style="align-items:center;text-align:center;">
          <h2 class="heading" style="max-width:560px;">Already certified? Don't let it lapse.</h2>
          <p class="text-medium" style="max-width:580px;">Book a 20-minute scoping call. We'll review your current evidence repository, surface any gaps, and give you a written quote within 48 hours.</p>
          <div class="button">
            <a href="/#contact?service=continuous-compliance" class="button-hidden w-button">Book a 20-min scoping call</a>
            <div class="button-wrapper"><div class="button-text">Book a 20-min scoping call</div></div>
            <div class="button-accent-gradinet"></div>
          </div>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>

<style>
  /* Page-local styles for the subscription page */
  .ccs-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
    margin-top: 1rem;
  }
  .ccs-card {
    padding: 1.5rem;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.09);
    border-radius: 12px;
  }
  .ccs-card-title {
    font-size: 1.05rem;
    font-weight: 600;
    color: #fff;
    margin: 0 0 0.5rem;
  }
  .ccs-card-body {
    font-size: 0.9rem;
    color: rgba(255,255,255,0.7);
    line-height: 1.6;
    margin: 0;
  }

  .ccs-tier-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin-top: 1rem;
  }
  .ccs-tier-card {
    position: relative;
    padding: 1.75rem;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.09);
    border-radius: 14px;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .ccs-tier-card-popular {
    border-color: rgba(36,215,88,0.4);
    background: rgba(36,215,88,0.04);
  }
  .ccs-tier-badge {
    position: absolute;
    top: -10px; left: 50%;
    transform: translateX(-50%);
    font-family: 'Geist Mono', ui-monospace, monospace;
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    background: linear-gradient(135deg, #24d758, #27dab4);
    color: #0a0a0a;
    font-weight: 700;
    white-space: nowrap;
  }
  .ccs-tier-name {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.55);
    margin: 0;
  }
  .ccs-tier-price {
    font-family: 'Geist Mono', ui-monospace, monospace;
    font-size: 1.55rem;
    font-weight: 700;
    color: #fff;
    margin: 0;
  }
  .ccs-tier-cycle {
    font-size: 0.85rem;
    font-weight: 500;
    color: rgba(255,255,255,0.5);
    margin-left: 0.25rem;
  }
  .ccs-tier-body {
    font-size: 0.88rem;
    color: rgba(255,255,255,0.7);
    line-height: 1.55;
    margin: 0;
  }
  .ccs-tier-footnote {
    font-size: 0.8rem;
    color: rgba(255,255,255,0.5);
    margin: 1.25rem 0 0;
    text-align: center;
  }

  .ccs-benefits {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-top: 1rem;
  }
  .ccs-benefit {
    padding: 1.25rem;
    background: rgba(36,215,88,0.04);
    border: 1px solid rgba(36,215,88,0.18);
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .ccs-benefit strong {
    color: #fff;
    font-size: 0.95rem;
  }
  .ccs-benefit span {
    color: rgba(255,255,255,0.65);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .grc-faq-list { max-width: 760px; margin: 0 auto; display: flex; flex-direction: column; gap: 0.75rem; }
  .grc-faq-item {
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 10px;
  }
  .grc-faq-item[open] { border-color: rgba(36,215,88,0.25); }
  .grc-faq-q {
    list-style: none; cursor: pointer;
    padding: 1.1rem 1.5rem;
    font-size: 0.95rem; font-weight: 500; color: #fff;
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
  }
  .grc-faq-q::-webkit-details-marker { display: none; }
  .grc-faq-icon { color: rgba(255,255,255,0.5); transition: transform 0.25s; }
  .grc-faq-item[open] .grc-faq-icon { transform: rotate(180deg); color: #24d758; }
  .grc-faq-a { padding: 0 1.5rem 1.25rem; color: rgba(255,255,255,0.72); font-size: 0.9rem; line-height: 1.65; }

  @media (max-width: 991px) {
    .ccs-grid, .ccs-tier-grid, .ccs-benefits { grid-template-columns: 1fr; }
  }
</style>
