---
// ===========================================
// CATEGORY HUB — Cybersecurity GRC
// 5 flagship services + Y2/Y3 coming-soon roadmap
// Underwings Cybersecurity Solutions
// ===========================================

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import '../../../styles/category-hub.css';

// Y1 flagship services
// hasPage: true = dedicated service page exists (Phase 3 anchor)
// hasPage: false = book-via-contact (Phase 3 deferred / Month 2)
const flagship = [
  {
    slug: "iso-27001-implementation",
    title: "ISO 27001 Implementation & Certification Support",
    tagline: "End-to-end from policy authoring to accredited-body audit.",
    price: "AED 50,000 – 120,000",
    certs: ["ISO 27001 LA", "GRC Mastery"],
    lead: "Manoj Prabhakaran",
    hasPage: true,
    href: "/services/grc/iso-27001-implementation",
  },
  {
    slug: "iso-27001-gap-assessment",
    title: "ISO 27001 Gap Assessment",
    tagline: "Current-state assessment + prioritised remediation roadmap.",
    price: "AED 20,000 – 40,000",
    certs: ["ISO 27001 LA"],
    lead: "Manoj Prabhakaran",
    hasPage: true,
    href: "/services/grc/iso-27001-gap-assessment",
  },
  {
    slug: "nesa-uae-ia",
    title: "NESA / UAE IA V2 Gap Assessment",
    tagline: "UAE national standards — full controls assessment for govt-adjacent clients.",
    price: "AED 20,000 – 50,000",
    certs: ["GRC Mastery", "ISO 27001 LA"],
    lead: "Manoj Prabhakaran",
    hasPage: true,
    href: "/services/grc/nesa-uae-ia",
  },
  {
    slug: "uae-pdpl-advisory",
    title: "UAE PDPL Compliance Advisory",
    tagline: "Data mapping, privacy notices, consent, breach-notification process.",
    price: "AED 15,000 – 35,000",
    certs: ["GRC Mastery", "ISO 27001 LA"],
    lead: "Manoj Prabhakaran",
    hasPage: true,
    href: "/services/grc/uae-pdpl-advisory",
  },
  {
    slug: "risk-assessment-register",
    title: "Risk Assessment & Risk Register Build",
    tagline: "ISO 27005-aligned, quantitative where appropriate. Standalone or ISO 27001 sub-deliverable.",
    price: "AED 20,000 – 45,000",
    certs: ["GRC Mastery", "ISO 27001 LA"],
    lead: "Manoj Prabhakaran",
    hasPage: true,
    href: "/services/grc/risk-assessment-register",
  },
];

// Year 2 (2027) roadmap
const comingY2 = [
  { slug: "incident-response-retainer", title: "Incident Response Retainer", desc: "Monthly retainer for IR SLA, playbook maintenance, and annual exercise. Your IR team on speed-dial." },
  { slug: "iso-27701", title: "ISO 27701:2025 (Privacy Information Management)", desc: "Privacy management systems layered on ISO 27001. Natural upsell as UAE PDPL enforcement tightens." },
  { slug: "nist-csf-risk-reporting", title: "NIST CSF 2.0 + Board Risk Reporting", desc: "Structured risk programs with appetite statements, registers, and quarterly board reports." },
  { slug: "vciso-retainer", title: "vCISO / Fractional CISO Retainer", desc: "Monthly fractional CISO for mid-market organisations not ready for a full-time hire." },
  { slug: "pci-dss-v4", title: "PCI DSS v4.0", desc: "Payment card compliance — launching if fintech is our Year-1 vertical anchor." },
  { slug: "dubai-isr-v2", title: "Dubai ISR v2", desc: "Dubai Government information security regulation — government-adjacent and supplier contracts." },
  { slug: "third-party-risk", title: "Third-Party Risk Assessment", desc: "Scalable vendor security assessment service. Mandated by UAE IA V2 and ISO 27001." },
];

// Year 3 (2028) roadmap
const comingY3 = [
  { slug: "nca-ecc-sama", title: "NCA ECC + SAMA CSF", desc: "Saudi Arabia market entry — NCA Essential Cybersecurity Controls + SAMA financial framework." },
  { slug: "cobit-2019", title: "COBIT 2019", desc: "Enterprise IT governance for banks, telcos, and government. C-suite engagement." },
  { slug: "iso-42001", title: "ISO/IEC 42001 — AI Governance", desc: "First-mover AI governance advisory in UAE — Every large client deploying AI; none have governance yet." },
  { slug: "dora-nis2", title: "DORA / NIS2", desc: "EU financial and critical-infrastructure directives. Demand-pull only — EU-linked clients." },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://underwings.org" },
      { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://underwings.org/services" },
      { "@type": "ListItem", "position": 3, "name": "Cybersecurity GRC", "item": "https://underwings.org/services/grc" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Cybersecurity GRC Services — Underwings",
    "itemListElement": flagship.map((s, i) => ({
      "@type": "ListItem",
      "position": i + 1,
      "name": s.title
    }))
  }
];

export const prerender = false;
---

<Layout
  title="Cybersecurity GRC in UAE — ISO 27001, NESA, PDPL Implementation | Underwings"
  description="UAE cybersecurity GRC services by an ISO 27001 Lead Auditor. ISO 27001 gap + implementation, NESA / UAE IA V2, UAE PDPL advisory, risk register. Published prices, partner-issued certification."
  keywords="ISO 27001 UAE, NESA gap assessment, UAE PDPL advisory, cybersecurity GRC Dubai, ISO 27001 consultant UAE, risk assessment UAE"
  wfPage="services-page"
  schema={schema}
  bodyClass="body svc-compact"
>
  <Header currentPage="services" />

  <main id="main" class="main">

    <!-- Breadcrumb + Hero -->
    <section class="section bottom-padding-clear top-padding-small">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab">
        <div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div>
      </div>
      <div class="container-medium">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">›</span>
          <a href="/services">Services</a>
          <span aria-hidden="true">›</span>
          <span class="crumbs-current">Cybersecurity GRC</span>
        </nav>

        <div class="hero">
          <div class="hero-main-wrapper">
            <div class="hero-heading-wrapper">
              <div class="label">
                <div class="text-small color-grey">Category — 5 flagship services</div>
              </div>
              <h1 class="heading-large hero-heading-large">Cybersecurity GRC — <span class="text-gradient-clip bg-color-green-gradient">Implementation, Not Just Advice</span></h1>
              <p class="text text-center" style="max-width:680px;margin:0 auto;">
                ISO 27001, NESA / UAE IA V2, PDPL, and formal risk programs — delivered hands-on by an ISO 27001 Lead Auditor and GRC Mastery practitioner. We implement. Accredited certification bodies certify. Never both.
              </p>
            </div>
          </div>
        </div>

        <div class="cert-ribbon">
          <span class="cert-ribbon-label">Powered by</span>
          <span class="cert-chip">ISO 27001 Lead Auditor</span>
          <span class="cert-chip">GRC Mastery</span>
          <span class="cert-chip">CDSA</span>
          <span class="cert-chip">Security+</span>
        </div>
      </div>
    </section>

    <!-- Flagship Services -->
    <section class="section bg-color-dark">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab">
        <div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div>
      </div>
      <div class="container">
        <div class="section-wrapper-vertical section-wrapper-vertical-large">
          <div class="heading-horizontal">
            <div class="heading-horizontal-inner">
              <div class="heading-horizontal-left-part">
                <h2 class="heading">Flagship services — available now</h2>
              </div>
              <div class="heading-horizontal-right-part">
                <p class="text-medium">Every engagement led by Manoj Prabhakaran, ISO 27001 Lead Auditor. Prices published — scoping call gives you a written quote within 48 hours.</p>
              </div>
            </div>
          </div>

          <div class="flag-grid">
            {flagship.map((svc) => (
              <a href={svc.href} class="flag-card" aria-label={`Learn about ${svc.title}`}>
                <div class="flag-card-head">
                  <span class="flag-price">{svc.price}</span>
                  {svc.hasPage ? (
                    <span class="flag-badge flag-badge-ready">Full page</span>
                  ) : (
                    <span class="flag-badge flag-badge-contact">Contact to scope</span>
                  )}
                </div>
                <h3 class="flag-title">{svc.title}</h3>
                <p class="flag-tagline">{svc.tagline}</p>
                <div class="flag-card-foot">
                  <span class="flag-lead">Led by {svc.lead}</span>
                  <span class="flag-certs">{svc.certs.join(" · ")}</span>
                </div>
                <div class="flag-cta">
                  <span>{svc.hasPage ? "Read full details" : "Start a scoping call"}</span>
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Coming 2027 -->
    <section class="section">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab">
        <div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div>
      </div>
      <div class="container">
        <div class="section-wrapper-vertical section-wrapper-vertical-large">
          <div class="heading-horizontal">
            <div class="heading-horizontal-inner">
              <div class="heading-horizontal-left-part">
                <h2 class="heading">Year 2 — 2027 roadmap</h2>
              </div>
              <div class="heading-horizontal-right-part">
                <p class="text-medium">Planned additions. Join the waitlist and we'll email you 30 days before each service launches.</p>
              </div>
            </div>
          </div>

          <div class="soon-grid">
            {comingY2.map((svc) => (
              <div class="soon-card" data-service-slug={svc.slug}>
                <div class="soon-card-head">
                  <span class="soon-badge soon-badge-2027">2027</span>
                </div>
                <h3 class="soon-title">{svc.title}</h3>
                <p class="soon-desc">{svc.desc}</p>
                <form class="soon-form" data-waitlist-form data-service-slug={svc.slug} data-service-year="2027">
                  <input type="email" name="email" placeholder="you@company.com" aria-label={`Email for ${svc.title} waitlist`} required />
                  <button type="submit" class="soon-btn">Add me to 2027 waitlist →</button>
                  <p class="soon-msg" aria-live="polite"></p>
                </form>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Coming 2028 -->
    <section class="section bg-color-dark">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab">
        <div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div>
      </div>
      <div class="container">
        <div class="section-wrapper-vertical section-wrapper-vertical-large">
          <div class="heading-horizontal">
            <div class="heading-horizontal-inner">
              <div class="heading-horizontal-left-part">
                <h2 class="heading">Year 3 — 2028 roadmap</h2>
              </div>
              <div class="heading-horizontal-right-part">
                <p class="text-medium">Advanced and regional expansion. Join a waitlist if you want first access.</p>
              </div>
            </div>
          </div>

          <div class="soon-grid">
            {comingY3.map((svc) => (
              <div class="soon-card" data-service-slug={svc.slug}>
                <div class="soon-card-head">
                  <span class="soon-badge soon-badge-2028">2028</span>
                </div>
                <h3 class="soon-title">{svc.title}</h3>
                <p class="soon-desc">{svc.desc}</p>
                <form class="soon-form" data-waitlist-form data-service-slug={svc.slug} data-service-year="2028">
                  <input type="email" name="email" placeholder="you@company.com" aria-label={`Email for ${svc.title} waitlist`} required />
                  <button type="submit" class="soon-btn">Add me to 2028 waitlist →</button>
                  <p class="soon-msg" aria-live="polite"></p>
                </form>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Why GRC matters for UAE -->
    <section class="section">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab">
        <div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div>
      </div>
      <div class="container-medium">
        <div class="section-wrapper-vertical">
          <div class="heading-horizontal">
            <div class="heading-horizontal-inner">
              <div class="heading-horizontal-left-part">
                <h2 class="heading">Why GRC matters for UAE</h2>
              </div>
              <div class="heading-horizontal-right-part">
                <p class="text-medium">Enforcement is moving from paper to penalty. A written policy isn't a program.</p>
              </div>
            </div>
          </div>
          <div class="why-uae-body">
            <p>UAE PDPL is in active enforcement. NESA / UAE IA V2 assessments are being run across semi-government and regulated sectors. ADHICS compliance is mandatory for Abu Dhabi healthcare providers. Dubai ISR v2 is a gate for any Dubai government supplier. Every one of these frameworks needs <strong>implementation, not more advice</strong>.</p>
            <p>Our team has lived inside these standards — not just read them — and we deliver hands-on programmes that end with audit-ready evidence and operational controls, partnered with accredited certification bodies where a certificate is required. Never both implementer and certifier. Never a conflict of interest.</p>
            <p class="why-uae-dogfood"><strong>We're pursuing our own ISO 27001:2022 certification in 2026 — the same program we deliver to clients, applied to ourselves first.</strong></p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Band -->
    <section class="section bg-color-dark">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab">
        <div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div>
      </div>
      <div class="container-medium">
        <div class="section-wrapper-vertical" style="align-items:center;text-align:center;">
          <h2 class="heading" style="max-width:560px;">Have an upcoming audit, a compliance directive, or a client asking for ISO 27001?</h2>
          <p class="text-medium" style="max-width:580px;">
            Book a free 30-minute scoping call. We'll scope your program, give you a written quote within 48 hours, and show you exactly what's involved — without the consultancy runaround.
          </p>
          <div class="button">
            <a href="/#contact?service=grc" class="button-hidden w-button">Book a Free GRC Scoping Call</a>
            <div class="button-wrapper">
              <div class="button-text">Book a Free GRC Scoping Call</div>
            </div>
            <div class="button-accent-gradinet"></div>
          </div>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>

<!-- Waitlist form handler (shared across all category hubs) -->
<script src="/js/waitlist.js" defer></script>
