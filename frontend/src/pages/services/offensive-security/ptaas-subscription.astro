---
// ============================================================
// SERVICE PAGE — PTaaS (Penetration Testing as a Service)
// Category: Offensive Security (recurring service — continuous testing)
// Aligned with canonical sub-page pattern (see network-penetration-testing.astro)
// ============================================================

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import '../../../styles/category-hub.css';
import '../../../styles/service-page.css';

const faqs = [
  { q: "How is this different from a one-off pen test?",                           a: "A one-off annual pen test gives you a snapshot. PTaaS gives you continuous coverage — when you push code or change infrastructure, we re-test the affected attack surface within days, not 12 months later. Findings appear in a live portal as we discover them, not in a PDF six weeks after fieldwork." },
  { q: "Who runs the tests?",                                                      a: "Same OSCP / CPTS practitioners who deliver our one-off engagements — Nelson Durairaj leads. No anonymous offshore juniors, no scan-and-PDF outsourcing. Every test action is logged with the operator's name." },
  { q: "How do you scope which assets to test?",                                   a: "At onboarding we define your perimeter: web apps, external network ranges, APIs, optional internal/AD, optional cloud config. Asset list is updated quarterly (or on-demand for major launches). Out-of-scope assets are never touched." },
  { q: "What if we find a critical issue between engagements?",                    a: "Critical findings get a same-day PoC + remediation guidance via the portal. We coordinate with your team on Slack/Teams until the fix is verified. No waiting for the next 'engagement window'." },
  { q: "Can we cancel?",                                                           a: "After the 12-month minimum, you can cancel with 30 days' notice. Before then, only with cause (e.g., we fail to deliver against the SLA)." },
  { q: "Is this a replacement for compliance pen tests?",                          a: "Yes — the annual deep-dive included on Standard and Pro tiers satisfies ISO 27001 Annex A 8.8, UAE IA V2 T3.6.1, ADHICS v2, PCI DSS 11.3, and SOC 2 CC7.1. We provide a signed attestation letter for your auditor." },
  { q: "Do you use automated tools?",                                              a: "Yes — Nuclei, Nessus, Burp Suite Pro, Nmap, BloodHound, custom recon tooling. Tools handle coverage; manual testing handles depth. Tools never write the report or decide what to exploit next." },
  { q: "What about destructive testing?",                                          a: "Never on production without explicit per-finding approval. Default rules of engagement exclude DoS, destructive exploits, and data-modifying actions. Anything risky is staged on copies first." },
];

const schema = [
  { "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home",                "item": "https://underwings.org" },
    { "@type": "ListItem", "position": 2, "name": "Services",            "item": "https://underwings.org/services" },
    { "@type": "ListItem", "position": 3, "name": "Offensive Security",  "item": "https://underwings.org/services/offensive-security" },
    { "@type": "ListItem", "position": 4, "name": "PTaaS — Penetration Testing as a Service", "item": "https://underwings.org/services/offensive-security/ptaas-subscription" }
  ]},
  { "@context": "https://schema.org", "@type": "Service", "name": "PTaaS — Penetration Testing as a Service",
    "serviceType": "Continuous Penetration Testing Subscription",
    "provider": { "@type": "Organization", "name": "Underwings Cybersecurity Solutions", "url": "https://underwings.org" },
    "areaServed": { "@type": "Country", "name": "United Arab Emirates" },
    "offers": { "@type": "AggregateOffer", "priceCurrency": "AED", "lowPrice": "6000", "highPrice": "14000" },
    "description": "UAE Penetration Testing as a Service — continuous OSCP-led testing, live findings portal, on-demand re-tests, included annual deep-dive. AED 6,000–14,000/month.",
    "url": "https://underwings.org/services/offensive-security/ptaas-subscription"
  },
  { "@context": "https://schema.org", "@type": "FAQPage",
    "mainEntity": faqs.map(f => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } }))
  }
];

export const prerender = false;
---

<Layout
  title="PTaaS UAE — Penetration Testing as a Service · OSCP-Led | Underwings"
  description="Continuous, OSCP-led penetration testing for UAE companies. Live findings portal, on-demand re-tests on every change, included annual deep-dive. AED 6,000–14,000/month."
  keywords="PTaaS UAE, penetration testing as a service Dubai, continuous pentest UAE, OSCP managed pentest, on-demand pentest Abu Dhabi, pentest subscription"
  wfPage="services-page"
  schema={schema}
  bodyClass="body svc-compact"
>
  <Header currentPage="services" />

  <main id="main" class="main">

    <!-- Breadcrumb + Hero -->
    <section class="section bottom-padding-clear top-padding-small">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"><div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div></div>
      <div class="container-medium">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><span aria-hidden="true">›</span>
          <a href="/services">Services</a><span aria-hidden="true">›</span>
          <a href="/services/offensive-security">Offensive Security</a><span aria-hidden="true">›</span>
          <span class="crumbs-current">PTaaS</span>
        </nav>

        <div class="svc-hero">
          <div class="label" style="justify-content:center;"><div class="text-small color-grey">Offensive Security — Recurring Service · NEW</div></div>
          <h1 class="heading-large">PTaaS — Penetration Testing as a Service</h1>
          <p class="text" style="max-width:680px;margin:1rem auto 0;">
            Stop testing once a year. <strong>Test every time something changes.</strong> Continuous OSCP-led coverage, a live findings portal, on-demand re-tests, and an included annual deep-dive — bundled into one monthly subscription.
          </p>

          <div class="svc-hero-badges">
            <span class="svc-hero-badge svc-hero-badge-price">AED 6,000 – 14,000 / month</span>
            <span class="svc-hero-badge svc-hero-badge-certs">OSCP · CPTS · CEH</span>
            <span class="svc-hero-badge svc-hero-badge-time">12-month minimum · cancel anytime after</span>
          </div>

          <div class="svc-hero-ctas">
            <div class="button">
              <a href="/#contact?service=ptaas" class="button-hidden w-button">Book a 20-min scoping call →</a>
              <div class="button-wrapper"><div class="button-text">Book a 20-min scoping call →</div></div>
              <div class="button-accent-gradinet"></div>
            </div>
            <a href="#faq" class="svc-hero-cta-secondary">Jump to FAQ</a>
          </div>
        </div>
      </div>
    </section>

    <!-- What it is -->
    <section class="section bg-color-dark">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"><div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div></div>
      <div class="container-medium">
        <h2 class="svc-sec-title">What it is</h2>
        <div class="svc-sec-body">
          <p>An annual penetration test produces a snapshot. The day after the report is delivered, your codebase changes, your infrastructure drifts, and the snapshot starts going stale. Twelve months later you find out what's broken — usually right before a customer audit, or after a breach.</p>
          <p>PTaaS is a <strong>continuous, OSCP-led testing programme</strong> with a live findings portal, on-demand re-tests when you push fixes, and a deep-dive annual engagement that satisfies your compliance pen-test obligation. You pay one monthly fee; we keep your offensive-security posture current.</p>
          <p>Same operators who deliver our one-off engagements. Same depth. Just continuous, with a portal between you and us instead of a PDF every twelve months.</p>
        </div>
      </div>
    </section>

    <!-- What it's NOT -->
    <section class="section">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"><div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div></div>
      <div class="container-medium">
        <h2 class="svc-sec-title">What this is <em>not</em></h2>
        <div class="svc-not-list">
          <div class="svc-not-item"><div class="svc-not-ico" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M3 3l6 6M9 3l-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></div><div><strong>Not a vulnerability scanner subscription.</strong> Scans are part of the toolkit; the work and the findings are human.</div></div>
          <div class="svc-not-item"><div class="svc-not-ico" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M3 3l6 6M9 3l-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></div><div><strong>Not 24/7 SOC monitoring or incident response.</strong> We test attackers' paths; we don't watch your alerts. SOC / IR is a separate offering on the 2027 roadmap.</div></div>
          <div class="svc-not-item"><div class="svc-not-ico" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M3 3l6 6M9 3l-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></div><div><strong>Not unlimited testing.</strong> Each tier has a defined hours envelope per month; out-of-scope work is quoted separately.</div></div>
          <div class="svc-not-item"><div class="svc-not-ico" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M3 3l6 6M9 3l-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></div><div><strong>Not red-team / adversary emulation.</strong> Full-scope adversary simulation (physical, social, multi-week campaigns) is a separate engagement on the 2028 roadmap.</div></div>
        </div>
      </div>
    </section>

    <!-- Who it's for -->
    <section class="section bg-color-dark">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"><div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div></div>
      <div class="container-medium">
        <h2 class="svc-sec-title">Who this is for</h2>
        <p class="svc-sec-body" style="margin-bottom:1.25rem;">You're probably here because one of these is true:</p>
        <div class="svc-triggers">
          <div class="svc-trigger"><div class="svc-trigger-num">1</div><div>You're a SaaS or product team that <strong>ships code weekly or daily</strong> and can't wait 12 months between pen tests.</div></div>
          <div class="svc-trigger"><div class="svc-trigger-num">2</div><div>You're under <strong>continuous compliance pressure</strong> (ISO 27001, ADHICS, PCI DSS) — this satisfies the annual pen-test requirement <em>plus</em> continuous control validation.</div></div>
          <div class="svc-trigger"><div class="svc-trigger-num">3</div><div>You're a mid-market firm <strong>without an internal red team</strong> — you want offensive coverage without the headcount.</div></div>
          <div class="svc-trigger"><div class="svc-trigger-num">4</div><div>You've been burned by a <strong>scan-and-PDF "VAPT"</strong> vendor and want live, named-practitioner testing with evidence trails.</div></div>
          <div class="svc-trigger"><div class="svc-trigger-num">5</div><div>An <strong>enterprise client or bank</strong> requires periodic pen-test attestation as a continuing onboarding condition.</div></div>
        </div>
      </div>
    </section>

    <!-- What you get -->
    <section class="section">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"><div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div></div>
      <div class="container-medium">
        <h2 class="svc-sec-title">What you get every month</h2>
        <ul class="svc-deliv-list">
          <li class="svc-deliv-item"><svg class="svc-deliv-ico" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8l3 3 7-7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg><div><strong>OSCP / CPTS-led active testing</strong> — hours envelope sized to your tier (8 / 16 / 28 hours per month).</div></li>
          <li class="svc-deliv-item"><svg class="svc-deliv-ico" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8l3 3 7-7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg><div><strong>Continuous reconnaissance</strong> — daily passive monitoring of your in-scope external surface (new subdomains, exposed services, certificate changes, leaked credentials).</div></li>
          <li class="svc-deliv-item"><svg class="svc-deliv-ico" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8l3 3 7-7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg><div><strong>Live findings portal</strong> — every finding with PoC, screenshots, severity, remediation guidance, and history. New findings are visible the day they're discovered.</div></li>
          <li class="svc-deliv-item"><svg class="svc-deliv-ico" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8l3 3 7-7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg><div><strong>On-demand re-tests within 5 business days</strong> of remediation; unlimited free re-tests for critical/high findings within 14 days.</div></li>
          <li class="svc-deliv-item"><svg class="svc-deliv-ico" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8l3 3 7-7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg><div><strong>Slack / Teams channel</strong> direct to the operator — same-day weekday response on critical findings.</div></li>
          <li class="svc-deliv-item"><svg class="svc-deliv-ico" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8l3 3 7-7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg><div><strong>Monthly testing dashboard</strong> — what was tested, what was found, what was fixed.</div></li>
          <li class="svc-deliv-item"><svg class="svc-deliv-ico" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8l3 3 7-7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg><div><strong>Annual deep-dive engagement</strong> (Standard &amp; Pro) — full-scope manual penetration test against your primary asset, with executive readout. Same depth as our standalone Professional tier.</div></li>
          <li class="svc-deliv-item"><svg class="svc-deliv-ico" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8l3 3 7-7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg><div><strong>Compliance attestation letter</strong> — signed letter mapping our testing to ISO 27001 Annex A 8.8, UAE IA V2 T3.6.1, ADHICS v2, PCI DSS 11.3, and SOC 2 CC7.1.</div></li>
        </ul>
      </div>
    </section>

    <!-- How we deliver -->
    <section class="section bg-color-dark">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"><div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div></div>
      <div class="container-medium">
        <h2 class="svc-sec-title">How we deliver</h2>
        <div class="svc-process-table">
          <div class="svc-process-row">
            <div class="svc-process-row-num">01</div>
            <div><div class="svc-process-row-step">Onboarding &amp; perimeter mapping</div><div class="svc-process-row-duration">Week 1</div></div>
            <div class="svc-process-row-desc">Asset inventory, rules of engagement signed, escalation contacts, blackout windows, portal account provisioned, Slack/Teams channel opened.</div>
          </div>
          <div class="svc-process-row">
            <div class="svc-process-row-num">02</div>
            <div><div class="svc-process-row-step">Baseline test cycle</div><div class="svc-process-row-duration">Weeks 2 – 4</div></div>
            <div class="svc-process-row-desc">First active test cycle covering your primary asset. Establishes baseline finding inventory in the portal.</div>
          </div>
          <div class="svc-process-row">
            <div class="svc-process-row-num">03</div>
            <div><div class="svc-process-row-step">Continuous monitoring + active cycles</div><div class="svc-process-row-duration">Recurring</div></div>
            <div class="svc-process-row-desc">Daily passive recon. Active test cycles per tier (quarterly on Lite, monthly on Standard, fortnightly on Pro). On-demand re-tests when you push fixes.</div>
          </div>
          <div class="svc-process-row">
            <div class="svc-process-row-num">04</div>
            <div><div class="svc-process-row-step">Critical-finding response</div><div class="svc-process-row-duration">Same-day on weekdays</div></div>
            <div class="svc-process-row-desc">PoC + remediation guidance for critical/high findings the day they're discovered. Slack/Teams coordination until fix is verified.</div>
          </div>
          <div class="svc-process-row">
            <div class="svc-process-row-num">05</div>
            <div><div class="svc-process-row-step">Annual deep-dive (Standard &amp; Pro)</div><div class="svc-process-row-duration">Month 11 – 12</div></div>
            <div class="svc-process-row-desc">Full-scope manual pen test, executive readout, signed attestation letter for your auditor. Same depth as our standalone Professional engagement.</div>
          </div>
          <div class="svc-process-row">
            <div class="svc-process-row-num">06</div>
            <div><div class="svc-process-row-step">Quarterly scope review</div><div class="svc-process-row-duration">Every 90 days</div></div>
            <div class="svc-process-row-desc">Review asset list, add new launches, retire decommissioned systems, refresh attestation letter.</div>
          </div>
        </div>
        <p class="text-small color-grey" style="margin-top:1rem;max-width:720px;"><strong>Cycle:</strong> 12-month rolling, renewing automatically unless cancelled with 30 days' notice. SLAs in writing.</p>
      </div>
    </section>

    <!-- Pricing -->
    <section class="section">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"><div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div></div>
      <div class="container-medium">
        <h2 class="svc-sec-title">Pricing — three tiers</h2>
        <div class="svc-sub-tier-grid">
          <div class="svc-sub-tier-card">
            <p class="svc-sub-tier-name">Lite</p>
            <p class="svc-sub-tier-price">AED 6,000<span class="svc-sub-tier-cycle">/month</span></p>
            <p class="svc-sub-tier-body">Single primary asset (one web app OR external network up to 30 IPs). Up to 8 hours/month testing. Quarterly active test cycles.</p>
          </div>
          <div class="svc-sub-tier-card svc-sub-tier-card-popular">
            <span class="svc-sub-tier-badge">Most popular</span>
            <p class="svc-sub-tier-name">Standard</p>
            <p class="svc-sub-tier-price">AED 9,500<span class="svc-sub-tier-cycle">/month</span></p>
            <p class="svc-sub-tier-body">Multi-asset (web + external network up to 100 IPs + APIs). Up to 16 hours/month. Monthly active cycles + included annual deep-dive.</p>
          </div>
          <div class="svc-sub-tier-card">
            <p class="svc-sub-tier-name">Pro</p>
            <p class="svc-sub-tier-price">AED 14,000<span class="svc-sub-tier-cycle">/month</span></p>
            <p class="svc-sub-tier-body">Full scope: web + network + AD + cloud config + mobile (if applicable). Up to 28 hours/month. Fortnightly cycles + executive board readout.</p>
          </div>
        </div>

        <div class="svc-pricing" style="margin-top:1.75rem;">
          <div class="svc-pricing-card">
            <h4>What drives the tier choice</h4>
            <ul class="svc-pricing-drivers">
              <li>Number and type of in-scope assets (web, network, API, AD, cloud, mobile)</li>
              <li>External IP range size</li>
              <li>Release cadence (more deploys = more re-test workload)</li>
              <li>Compliance obligation (annual deep-dive required = Standard or Pro)</li>
              <li>Sector regulation (regulated sectors typically land on Pro)</li>
            </ul>
          </div>
          <div class="svc-pricing-card">
            <h4>Commercial terms</h4>
            <ul class="svc-pricing-terms">
              <li><strong>Billing:</strong> Monthly in advance</li>
              <li><strong>Minimum term:</strong> 12 months</li>
              <li><strong>After minimum:</strong> Cancel anytime with 30 days' notice</li>
              <li><strong>Tier upgrade:</strong> Pro-rated, takes effect next billing cycle</li>
              <li><strong>Quote validity:</strong> 30 days</li>
              <li><strong>Hours over envelope:</strong> Quoted separately, never auto-billed</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Named team -->
    <section class="section bg-color-dark">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"><div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div></div>
      <div class="container-medium">
        <h2 class="svc-sec-title">Your cert-backed team</h2>
        <p class="svc-sec-body" style="margin-bottom:1.5rem;">Same named operator across every cycle — continuity, not lottery.</p>
        <div class="svc-team">
          <div class="svc-team-card">
            <p class="svc-team-role">Lead Operator</p>
            <h3 class="svc-team-name">Nelson Durairaj</h3>
            <p class="svc-team-certs">OSCP · eJPT · CEH · BlackHat Linux · HTB Omniscient</p>
            <p class="svc-team-focus"><strong>Focus:</strong> Continuous reconnaissance, active web/API/network testing, on-demand re-tests, finding triage on Slack/Teams.</p>
          </div>
          <div class="svc-team-card">
            <p class="svc-team-role">Supervising Practitioner</p>
            <h3 class="svc-team-name">Manoj Prabhakaran</h3>
            <p class="svc-team-certs">CPTS · CDSA · Security+ · Azure Cloud Security · ISO 27001 Lead Auditor</p>
            <p class="svc-team-focus"><strong>Focus:</strong> Annual deep-dive oversight, attestation letter sign-off, audit-evidence alignment, complex AD/cloud engagements.</p>
          </div>
        </div>
        <p class="text-small color-grey" style="margin-top:1.25rem;"><a href="/about" style="color:#37dc82;text-decoration:underline;">See the full team →</a></p>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section" id="faq">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"><div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div></div>
      <div class="container-medium">
        <h2 class="svc-sec-title">Frequently asked questions</h2>
        <div class="svc-faq">
          {faqs.map(item => (
            <details class="svc-faq-item">
              <summary>{item.q}</summary>
              <p class="svc-faq-answer" set:html={item.a}></p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Related -->
    <section class="section bg-color-dark">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"><div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div></div>
      <div class="container-medium">
        <h2 class="svc-sec-title">You might also need</h2>
        <div class="svc-related-grid">
          <a href="/services/offensive-security/network-penetration-testing" class="svc-related-card">
            <h4>Network Penetration Testing</h4>
            <p>One-off engagement if you're not ready for a subscription — same operators, same depth.</p>
            <div class="svc-related-cta">Read full details <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M3 6h6M7 3l3 3-3 3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
          </a>
