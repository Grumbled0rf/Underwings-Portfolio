---
// ===========================================
// CATEGORY HUB — Offensive Security
// PTES / OWASP-aligned. Pre-engagement-first structure.
// 5 flagship services + Y2/Y3 coming-soon roadmap
// ===========================================

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import '../../../styles/category-hub.css';
import '../../../styles/offensive-hub.css';

const flagship = [
  {
    slug: "network-penetration-testing",
    title: "Network Penetration Testing",
    tagline: "External + internal + Active Directory + lateral movement. PTES-aligned, manual, exploit-driven.",
    price: "AED 20,000 – 60,000",
    methodology: "PTES · NIST SP 800-115",
    lead: "Nelson Durairaj",
    hasPage: true,
    href: "/services/offensive-security/network-penetration-testing",
  },
  {
    slug: "web-application-penetration-testing",
    title: "Web Application Penetration Testing",
    tagline: "OWASP Top 10, API security, authentication flaws, business-logic testing.",
    price: "AED 15,000 – 40,000",
    methodology: "OWASP WSTG · API Top 10",
    lead: "Nelson Durairaj",
    hasPage: true,
    href: "/services/offensive-security/web-application-penetration-testing",
  },
  {
    slug: "mobile-application-penetration-testing",
    title: "Mobile Application Penetration Testing",
    tagline: "iOS and Android — static + dynamic, Frida runtime instrumentation, MASVS-mapped.",
    price: "AED 18,000 – 45,000",
    methodology: "OWASP MASTG · MASVS",
    lead: "Nelson Durairaj",
    hasPage: true,
    href: "/services/offensive-security/mobile-application-penetration-testing",
    isNew: true,
  },
  {
    slug: "phishing-simulation",
    title: "Phishing Simulation & Social Engineering",
    tagline: "Controlled phishing and vishing campaigns with click-rate reporting. Before/after metric for awareness training.",
    price: "AED 8,000 – 20,000",
    methodology: "PTES Pre-engagement · NIST SP 800-115",
    lead: "Nelson Durairaj",
    hasPage: true,
    href: "/services/offensive-security/phishing-simulation",
  },
  {
    slug: "vulnerability-assessment",
    title: "Vulnerability Assessment (VA only)",
    tagline: "Scan-and-prioritise service for SMEs not ready for full pen testing. Fast, affordable, actionable.",
    price: "AED 5,000 – 15,000",
    methodology: "NIST SP 800-115",
    lead: "Nelson Durairaj",
    hasPage: true,
    href: "/services/offensive-security/vulnerability-assessment",
  },
];

// PTES + HTB-aligned 8-stage process (client-facing adaptation)
const stages = [
  { num: "01", name: "Pre-Engagement", desc: "NDA, scoping workshop, rules of engagement, timeline, deliverable lock. We educate, you choose scope.", clientFacing: true },
  { num: "02", name: "Information Gathering", desc: "Passive + active reconnaissance. OSINT, enumeration, technology fingerprinting, attack-surface mapping." },
  { num: "03", name: "Vulnerability Assessment", desc: "Automated + manual analysis. Known CVE sweep, configuration review, version analysis, attack-vector hypothesis." },
  { num: "04", name: "Exploitation", desc: "Controlled execution of attack paths. Every exploit documented, every action reversible." },
  { num: "05", name: "Post-Exploitation", desc: "Privilege escalation, impact demonstration, pillaging for sensitive data. We show what an attacker would actually get." },
  { num: "06", name: "Lateral Movement", desc: "If in scope — pivot through the environment, chain access, demonstrate breach spread. Internal network engagements only." },
  { num: "07", name: "Proof-of-Concept", desc: "Reproducible evidence for every finding. Screenshots, scripts, step-by-step. No unverifiable claims." },
  { num: "08", name: "Post-Engagement", desc: "Executive summary, technical report, live walkthrough, clean-up evidence, free 30-day retest of critical/high fixes.", clientFacing: true },
];

// Scope chips — what client can include in engagement
const scopes = [
  { key: "network-ext", label: "External Network", desc: "Internet-exposed infrastructure, perimeter", href: "/services/offensive-security/network-penetration-testing" },
  { key: "network-int", label: "Internal Network", desc: "Corporate LAN, Active Directory, lateral movement", href: "/services/offensive-security/network-penetration-testing" },
  { key: "webapp", label: "Web Application", desc: "OWASP WSTG — authenticated, business logic", href: "/services/offensive-security/web-application-penetration-testing" },
  { key: "mobile", label: "Mobile App (iOS / Android)", desc: "OWASP MASTG — static + dynamic + runtime", href: "/services/offensive-security/mobile-application-penetration-testing", isNew: true },
  { key: "api", label: "API", desc: "OWASP API Top 10 — REST, GraphQL, SOAP", href: "/services/offensive-security/web-application-penetration-testing" },
  { key: "wireless", label: "Wireless", desc: "WiFi, rogue-AP, Evil Twin, WPA2/3 weaknesses", href: "#scoping" },
  { key: "phishing", label: "Phishing & Social Engineering", desc: "Email, SMS, vishing — realistic attacker simulation", href: "/services/offensive-security/phishing-simulation" },
  { key: "cloud", label: "Cloud Configuration", desc: "AWS, Azure, GCP — IAM, misconfig, privilege paths", href: "/services/cloud-security" },
  { key: "va-only", label: "VA only (budget)", desc: "Scan + prioritise. Compliance box-check, not a pen test", href: "/services/offensive-security/vulnerability-assessment" },
];

// Compliance framework → required/recommended scope mapping
const compliance = [
  { framework: "ISO 27001 (Annex A 8.8)", required: "VA + annual pen test", recommended: "External network + primary web app", link: "/services/grc/iso-27001-implementation" },
  { framework: "UAE IA V2 (T3.6.1)", required: "External + internal pen test", recommended: "+ phishing simulation + wireless", link: "/services/grc" },
  { framework: "ADHICS v2 (Healthcare UAE)", required: "Annual pen test", recommended: "+ mobile app (if patient-facing) + PHI systems", link: "/services/grc" },
  { framework: "PCI DSS 11.3", required: "Internal + external pen test", recommended: "+ segmentation testing + web app (if CDE)", link: "/services/grc" },
  { framework: "SOC 2 (CC7.1)", required: "Annual pen test", recommended: "External network + web app + API", link: "/services/grc" },
];

const comingY2 = [
  { slug: "third-party-vendor-risk", title: "Third-Party / Vendor Risk Assessment", desc: "Assess the cybersecurity posture of your suppliers and vendors. UAE IA V2 and ISO 27001 both require it — we deliver it via a scalable questionnaire framework." },
  { slug: "managed-vulnerability-management", title: "Managed Vulnerability Management", desc: "Continuous scanning, prioritisation, and remediation tracking — delivered as a monthly retainer with your named engineer." },
];

const comingY3 = [
  { slug: "red-team-exercises", title: "Red Team Exercises", desc: "Full-scope adversary simulation across people, process, and technology. Physical, digital, social engineering. Requires senior CRTO / OSEP hire." },
  { slug: "soc-mdr", title: "SOC-as-a-Service / MDR", desc: "24/7 monitoring, threat detection, and response. MSSP partnership bridge in Year 2 before own build in Year 3." },
  { slug: "dfir", title: "Digital Forensics & Incident Response (DFIR)", desc: "Breach investigation, forensic reporting, legal-grade evidence handling. Licensed tools + GCFE / GCFA certified analysts." },
  { slug: "cyber-threat-intelligence", title: "Cyber Threat Intelligence (CTI)", desc: "Sector-specific threat intel, dark-web brand monitoring, quarterly executive briefings." },
  { slug: "ot-ics-security", title: "OT / ICS Security (IEC 62443)", desc: "Operational technology security for utilities, energy, manufacturing. Specialist hire required; anchor-client driven." },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://underwings.org" },
      { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://underwings.org/services" },
      { "@type": "ListItem", "position": 3, "name": "Offensive Security", "item": "https://underwings.org/services/offensive-security" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Offensive Security Services — Underwings",
    "itemListElement": flagship.map((s, i) => ({
      "@type": "ListItem", "position": i + 1, "name": s.title
    }))
  }
];

export const prerender = false;
---

<Layout
  title="Penetration Testing Services UAE | Underwings"
  description="UAE penetration testing by OSCP and CPTS-certified practitioners. PTES, OWASP WSTG / MASTG / API, NIST SP 800-115 aligned. Network, web app, mobile, API, phishing, cloud. Transparent pricing. Free first retest."
  keywords="penetration testing UAE, pen test Dubai, PTES UAE, OWASP pentest UAE, mobile app pentest UAE, network pen test Abu Dhabi, VAPT UAE, cybersecurity startup Dubai"
  wfPage="services-page"
  schema={schema}
  bodyClass="body svc-compact"
>
  <Header currentPage="services" />

  <main id="main" class="main">

    <!-- Hero -->
    <section class="section bottom-padding-clear top-padding-small">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab">
        <div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div>
      </div>
      <div class="container-medium">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">›</span>
          <a href="/services">Services</a>
          <span aria-hidden="true">›</span>
          <span class="crumbs-current">Offensive Security</span>
        </nav>

        <div class="hero">
          <div class="hero-main-wrapper">
            <div class="hero-heading-wrapper">
              <div class="label">
                <div class="text-small color-grey">Penetration Testing — done the way it should be</div>
              </div>
              <h1 class="heading-large hero-heading-large">Offensive Security — <span class="text-gradient-clip bg-color-green-gradient">Not a Vulnerability Scan</span></h1>
              <p class="text text-center" style="max-width:720px;margin:0 auto;">
                Most UAE clients ask "I need pen testing for compliance" without knowing scope. That's fine — <strong>scoping is our job, not yours</strong>. Our 8-stage PTES-aligned process figures out exactly what your audit, client, or threat model actually needs.
              </p>
            </div>
          </div>
        </div>

        <div class="method-ribbon">
          <span class="method-ribbon-label">Methodology</span>
          <span class="method-chip">PTES</span>
          <span class="method-chip">OWASP WSTG</span>
          <span class="method-chip">OWASP MASTG</span>
          <span class="method-chip">OWASP API Top 10</span>
          <span class="method-chip">NIST SP 800-115</span>
          <span class="method-chip">MITRE ATT&amp;CK</span>
        </div>
      </div>
    </section>

    <!-- START HERE — Pre-Engagement entry band -->
    <section class="section bg-color-dark" id="start-here">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab">
        <div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div>
      </div>
      <div class="container-medium">
        <div class="section-wrapper-vertical">
          <div class="heading-horizontal">
            <div class="heading-horizontal-inner">
              <div class="heading-horizontal-left-part">
                <h2 class="heading">Start here — Pre-Engagement</h2>
              </div>
              <div class="heading-horizontal-right-part">
                <p class="text-medium">Pick the path that matches where you are. We'll walk you through scoping in a free 30-minute call.</p>
              </div>
            </div>
          </div>

          <div class="entry-grid">
            <a href="#compliance" class="entry-card">
              <div class="entry-card-num">A</div>
              <h3 class="entry-card-title">I need it for compliance</h3>
              <p class="entry-card-desc">ISO 27001, UAE IA, ADHICS, PCI DSS, SOC 2 — tell us the framework, we'll map exactly which scope your auditor expects.</p>
              <div class="entry-card-cta">See compliance mapping →</div>
            </a>

            <a href="#scoping" class="entry-card">
              <div class="entry-card-num">B</div>
              <h3 class="entry-card-title">I know what I want tested</h3>
              <p class="entry-card-desc">Network, web app, mobile, API, phishing, cloud — pick your scope chips. Multi-select supported; bundled discounts apply.</p>
              <div class="entry-card-cta">Pick your scope →</div>
            </a>

            <a href="/services/offensive-security/scope-builder" class="entry-card entry-card-featured">
              <div class="entry-card-num">C</div>
              <h3 class="entry-card-title">I'm not sure where to start</h3>
              <p class="entry-card-desc">Answer 4 questions in 2 minutes. We'll recommend scope, show indicative AED pricing, and email you a full scoping brief. No sales call required.</p>
              <div class="entry-card-cta">Open the Scope Builder →</div>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Scope selector -->
    <section class="section" id="scoping">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab">
        <div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div>
      </div>
      <div class="container-medium">
        <div class="section-wrapper-vertical">
          <div class="heading-horizontal">
            <div class="heading-horizontal-inner">
              <div class="heading-horizontal-left-part">
                <h2 class="heading">What can be in scope</h2>
              </div>
              <div class="heading-horizontal-right-part">
                <p class="text-medium">In scoping, we pick together. You choose the attack surface; we apply the appropriate methodology to each.</p>
              </div>
            </div>
          </div>

          <div class="scope-grid">
            {scopes.map((s) => (
              <a href={s.href} class="scope-chip" aria-label={`Scope: ${s.label}`}>
                {s.isNew && <span class="scope-new">New</span>}
                <h4 class="scope-chip-label">{s.label}</h4>
                <p class="scope-chip-desc">{s.desc}</p>
                <div class="scope-chip-cta">Read more
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M3 6h6M7 3l3 3-3 3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </div>
              </a>
            ))}
          </div>

          <p class="scope-footnote">Bundle 2+ scopes in one engagement for <strong>15% discount</strong>. Bundle 3+ for <strong>20%</strong>.</p>
        </div>
      </div>
    </section>

    <!-- 8-stage PTES process -->
    <section class="section bg-color-dark">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab">
        <div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div>
      </div>
      <div class="container-medium">
        <div class="section-wrapper-vertical">
          <div class="heading-horizontal">
            <div class="heading-horizontal-inner">
              <div class="heading-horizontal-left-part">
                <h2 class="heading">Our 8-stage penetration testing process</h2>
              </div>
              <div class="heading-horizontal-right-part">
                <p class="text-medium">Based on PTES (Penetration Testing Execution Standard), OWASP methodology guides, and NIST SP 800-115. The engineering discipline most "VAPT" providers skip.</p>
              </div>
            </div>
          </div>

          <ol class="ptes-stages">
            {stages.map((stage) => (
              <li class={`ptes-stage ${stage.clientFacing ? 'ptes-stage-client' : ''}`}>
                <div class="ptes-stage-num">{stage.num}</div>
                <div class="ptes-stage-body">
                  <h3 class="ptes-stage-name">
                    {stage.name}
                    {stage.clientFacing && <span class="ptes-client-tag">You're involved</span>}
                  </h3>
                  <p class="ptes-stage-desc">{stage.desc}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- Flagship services -->
    <section class="section">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab">
        <div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div>
      </div>
      <div class="container">
        <div class="section-wrapper-vertical section-wrapper-vertical-large">
          <div class="heading-horizontal">
            <div class="heading-horizontal-inner">
              <div class="heading-horizontal-left-part">
                <h2 class="heading">Flagship services — available now</h2>
              </div>
              <div class="heading-horizontal-right-part">
                <p class="text-medium">Led by Nelson Durairaj (OSCP, eJPT, CEH), supervised by Manoj Prabhakaran (CPTS, CDSA). No juniors running scanners, no anonymous teams.</p>
              </div>
            </div>
          </div>

          <div class="flag-grid flag-grid-five">
            {flagship.map((svc) => (
              <a href={svc.href} class="flag-card" aria-label={`Learn about ${svc.title}`}>
                <div class="flag-card-head">
                  <span class="flag-price">{svc.price}</span>
                  {svc.isNew ? (
                    <span class="flag-badge flag-badge-new">New</span>
                  ) : (
                    <span class="flag-badge flag-badge-ready">Full page</span>
                  )}
                </div>
                <h3 class="flag-title">{svc.title}</h3>
                <p class="flag-tagline">{svc.tagline}</p>
                <div class="flag-card-foot">
                  <span class="flag-lead">Led by {svc.lead}</span>
                  <span class="flag-certs">{svc.methodology}</span>
                </div>
                <div class="flag-cta">
                  <span>Read full details</span>
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Compliance mapping -->
    <section class="section bg-color-dark" id="compliance">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab">
        <div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div>
      </div>
      <div class="container-medium">
        <div class="section-wrapper-vertical">
          <div class="heading-horizontal">
            <div class="heading-horizontal-inner">
              <div class="heading-horizontal-left-part">
                <h2 class="heading">Compliance mapping — which scope your framework needs</h2>
              </div>
              <div class="heading-horizontal-right-part">
                <p class="text-medium">Tell us the framework, we'll scope to match. Our reports are audit-grade: CVSS-scored findings, control-mapped, walkthrough-delivered.</p>
              </div>
            </div>
          </div>

          <div class="compliance-table-wrap">
            <table class="compliance-table">
              <thead>
                <tr>
                  <th>Framework</th>
                  <th>Required</th>
                  <th>Recommended additions</th>
                </tr>
              </thead>
              <tbody>
                {compliance.map((row) => (
                  <tr>
                    <td><a href={row.link}>{row.framework}</a></td>
                    <td>{row.required}</td>
                    <td>{row.recommended}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <!-- Transparent startup pricing -->
    <section class="section">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab">
        <div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div>
      </div>
      <div class="container-medium">
        <div class="section-wrapper-vertical">
          <div class="heading-horizontal">
            <div class="heading-horizontal-inner">
              <div class="heading-horizontal-left-part">
                <h2 class="heading">Transparent pricing</h2>
              </div>
              <div class="heading-horizontal-right-part">
                <p class="text-medium">We're a new UAE firm. We publish prices to earn your first case study — not to hide behind enterprise-sales opacity.</p>
              </div>
            </div>
          </div>

          <div class="price-callout">
            <strong>Founding-client offer —</strong> the first three UAE clients per service line get <strong>25% off</strong> in exchange for a named testimonial and case study rights.
          </div>

          <div class="price-table-wrap">
            <table class="price-table">
              <thead>
                <tr>
                  <th>Scope</th>
                  <th>Starting at (AED)</th>
                  <th>Typical duration</th>
                </tr>
              </thead>
              <tbody>
                <tr><td>VA only (up to 50 IPs)</td><td>5,000</td><td>3 days</td></tr>
                <tr><td>External network pentest (small)</td><td>20,000</td><td>5 – 7 days</td></tr>
                <tr><td>Internal network pentest (AD, lateral)</td><td>35,000</td><td>8 – 12 days</td></tr>
                <tr><td>Web application (1 app, authenticated)</td><td>15,000</td><td>7 – 14 days</td></tr>
                <tr><td>Mobile app (1 platform, iOS <em>or</em> Android)</td><td>18,000</td><td>7 – 10 days</td></tr>
                <tr><td>Mobile app (both iOS + Android)</td><td>30,000</td><td>10 – 14 days</td></tr>
                <tr><td>API pentest (standalone)</td><td>15,000</td><td>5 – 10 days</td></tr>
                <tr><td>Phishing simulation (up to 200 users)</td><td>8,000</td><td>2 weeks campaign</td></tr>
                <tr><td>Bundle: Network + Web App</td><td>32,000</td><td>2 – 3 weeks</td></tr>
                <tr><td>Bundle: Full-stack (Network + Web + Mobile)</td><td>55,000</td><td>4 – 5 weeks</td></tr>
              </tbody>
            </table>
          </div>

          <p class="price-footnote">
            All engagements include: scoping workshop, rules-of-engagement document, CVSS-scored findings report, executive summary, 90-min remediation walkthrough, and <strong>one free retest of critical/high findings within 30 days</strong>. VAT extra. Written quote within 48 hours of scoping call.
          </p>
        </div>
      </div>
    </section>

    <!-- Deliverables -->
    <section class="section bg-color-dark">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab">
        <div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div>
      </div>
      <div class="container-medium">
        <div class="section-wrapper-vertical">
          <div class="heading-horizontal">
            <div class="heading-horizontal-inner">
              <div class="heading-horizontal-left-part">
                <h2 class="heading">What you actually get</h2>
              </div>
              <div class="heading-horizontal-right-part">
                <p class="text-medium">Every engagement, every scope. Audit-grade deliverables designed for UAE compliance contexts.</p>
              </div>
            </div>
          </div>

          <ul class="deliverables-grid">
            <li class="deliverable-item">
              <div class="deliverable-num">01</div>
              <h4>Executive summary</h4>
              <p>1 – 2 pages, board-consumable. Business impact, risk posture, remediation priority.</p>
            </li>
            <li class="deliverable-item">
              <div class="deliverable-num">02</div>
              <h4>Technical findings report</h4>
              <p>CVSS-scored findings with reproduction steps, screenshots, and remediation guidance. Typically 20 – 50 pages.</p>
            </li>
            <li class="deliverable-item">
              <div class="deliverable-num">03</div>
              <h4>PoC evidence pack</h4>
              <p>Scripts, payloads, Frida hooks — everything your dev team needs to reproduce locally.</p>
            </li>
            <li class="deliverable-item">
              <div class="deliverable-num">04</div>
              <h4>Compliance mapping</h4>
              <p>Findings cross-referenced to ISO 27001 Annex A, UAE IA, ADHICS, PCI DSS controls as relevant.</p>
            </li>
            <li class="deliverable-item">
              <div class="deliverable-num">05</div>
              <h4>Live walkthrough</h4>
              <p>90-minute session with your engineers — every critical and high finding demonstrated live.</p>
            </li>
            <li class="deliverable-item">
              <div class="deliverable-num">06</div>
              <h4>Free 30-day retest</h4>
              <p>Validate your fixes on critical and high findings within 30 days of remediation. Separate retest report issued.</p>
