---
// ===========================================
// CATEGORY HUB — Offensive Security
// 4 flagship services + Y2/Y3 coming-soon roadmap
// ===========================================

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import '../../../styles/category-hub.css';

const flagship = [
  {
    slug: "network-penetration-testing",
    title: "Network Penetration Testing",
    tagline: "External + internal + Active Directory + lateral movement. Manual, exploit-driven, OSCP-led.",
    price: "AED 20,000 – 60,000",
    certs: ["OSCP", "CPTS", "CEH"],
    lead: "Nelson Durairaj",
    hasPage: true,
    href: "/services/offensive-security/network-penetration-testing",
  },
  {
    slug: "web-application-penetration-testing",
    title: "Web Application Penetration Testing",
    tagline: "OWASP Top 10, API security, authentication flaws, business-logic testing.",
    price: "AED 15,000 – 40,000",
    certs: ["CPTS", "CEH", "OSCP"],
    lead: "Nelson Durairaj",
    hasPage: true,
    href: "/services/offensive-security/web-application-penetration-testing",
  },
  {
    slug: "phishing-simulation",
    title: "Phishing Simulation & Social Engineering",
    tagline: "Controlled phishing and vishing campaigns with click-rate reporting. Perfect before/after metric for Awareness Training.",
    price: "AED 8,000 – 20,000",
    certs: ["CEH", "CPTS"],
    lead: "Nelson Durairaj",
    hasPage: true,
    href: "/services/offensive-security/phishing-simulation",
  },
  {
    slug: "vulnerability-assessment",
    title: "Vulnerability Assessment (VA only)",
    tagline: "Scan-and-prioritise service for SMEs not ready for full pen testing. Fast, affordable, actionable.",
    price: "AED 5,000 – 15,000",
    certs: ["OSCP", "CPTS"],
    lead: "Nelson Durairaj",
    hasPage: true,
    href: "/services/offensive-security/vulnerability-assessment",
  },
];

const comingY2 = [
  { slug: "third-party-vendor-risk", title: "Third-Party / Vendor Risk Assessment", desc: "Assess the cybersecurity posture of your suppliers and vendors. UAE IA V2 and ISO 27001 both require it — we deliver it via a scalable questionnaire framework." },
  { slug: "managed-vulnerability-management", title: "Managed Vulnerability Management", desc: "Continuous scanning, prioritisation, and remediation tracking — delivered as a monthly retainer with your named engineer." },
];

const comingY3 = [
  { slug: "red-team-exercises", title: "Red Team Exercises", desc: "Full-scope adversary simulation across people, process, and technology. Physical, digital, social engineering. Requires senior CRTO / OSEP hire." },
  { slug: "soc-mdr", title: "SOC-as-a-Service / MDR", desc: "24/7 monitoring, threat detection, and response. MSSP partnership bridge in Year 2 before own build in Year 3." },
  { slug: "dfir", title: "Digital Forensics & Incident Response (DFIR)", desc: "Breach investigation, forensic reporting, legal-grade evidence handling. Licensed tools + GCFE / GCFA certified analysts." },
  { slug: "cyber-threat-intelligence", title: "Cyber Threat Intelligence (CTI)", desc: "Sector-specific threat intel, dark-web brand monitoring, quarterly executive briefings." },
  { slug: "ot-ics-security", title: "OT / ICS Security (IEC 62443)", desc: "Operational technology security for utilities, energy, manufacturing. Specialist hire required; anchor-client driven." },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://underwings.org" },
      { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://underwings.org/services" },
      { "@type": "ListItem", "position": 3, "name": "Offensive Security", "item": "https://underwings.org/services/offensive-security" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Offensive Security Services — Underwings",
    "itemListElement": flagship.map((s, i) => ({
      "@type": "ListItem", "position": i + 1, "name": s.title
    }))
  }
];

export const prerender = false;
---

<Layout
  title="Offensive Security in UAE — Pen Testing, Phishing Sims, VA | Underwings"
  description="UAE offensive security services by OSCP and CPTS certified practitioners. Network pen testing, web app pen testing, phishing simulation, vulnerability assessment. Manual testing, not vuln-scan PDFs."
  keywords="penetration testing UAE, pen test Dubai, OSCP pentester UAE, web application pen testing Abu Dhabi, phishing simulation UAE, vulnerability assessment UAE"
  wfPage="services-page"
  schema={schema}
  bodyClass="body svc-compact"
>
  <Header currentPage="services" />

  <main id="main" class="main">

    <!-- Breadcrumb + Hero -->
    <section class="section bottom-padding-clear top-padding-small">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab">
        <div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div>
      </div>
      <div class="container-medium">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">›</span>
          <a href="/services">Services</a>
          <span aria-hidden="true">›</span>
          <span class="crumbs-current">Offensive Security</span>
        </nav>

        <div class="hero">
          <div class="hero-main-wrapper">
            <div class="hero-heading-wrapper">
              <div class="label">
                <div class="text-small color-grey">Category — 4 flagship services</div>
              </div>
              <h1 class="heading-large hero-heading-large">Offensive Security — <span class="text-gradient-clip bg-color-green-gradient">Not a Vulnerability Scan</span></h1>
              <p class="text text-center" style="max-width:680px;margin:0 auto;">
                Manual penetration testing, phishing simulations, and vulnerability assessments — led by OSCP, CPTS, and CEH holders. Every engagement ends with a live walkthrough and a free re-test of critical findings.
              </p>
            </div>
          </div>
        </div>

        <div class="cert-ribbon">
          <span class="cert-ribbon-label">Powered by</span>
          <span class="cert-chip">OSCP</span>
          <span class="cert-chip">CPTS</span>
          <span class="cert-chip">CEH</span>
          <span class="cert-chip">CDSA</span>
        </div>
      </div>
    </section>

    <!-- Flagship -->
    <section class="section bg-color-dark">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab">
        <div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div>
      </div>
      <div class="container">
        <div class="section-wrapper-vertical section-wrapper-vertical-large">
          <div class="heading-horizontal">
            <div class="heading-horizontal-inner">
              <div class="heading-horizontal-left-part">
                <h2 class="heading">Flagship services — available now</h2>
              </div>
              <div class="heading-horizontal-right-part">
                <p class="text-medium">Led by Nelson Durairaj (OSCP, eJPT, CEH), supervised by Manoj Prabhakaran (CPTS, CDSA). No juniors running scanners, no anonymous teams.</p>
              </div>
            </div>
          </div>

          <div class="flag-grid">
            {flagship.map((svc) => (
              <a href={svc.href} class="flag-card" aria-label={`Learn about ${svc.title}`}>
                <div class="flag-card-head">
                  <span class="flag-price">{svc.price}</span>
                  {svc.hasPage ? (
                    <span class="flag-badge flag-badge-ready">Full page</span>
                  ) : (
                    <span class="flag-badge flag-badge-contact">Contact to scope</span>
                  )}
                </div>
                <h3 class="flag-title">{svc.title}</h3>
                <p class="flag-tagline">{svc.tagline}</p>
                <div class="flag-card-foot">
                  <span class="flag-lead">Led by {svc.lead}</span>
                  <span class="flag-certs">{svc.certs.join(" · ")}</span>
                </div>
                <div class="flag-cta">
                  <span>{svc.hasPage ? "Read full details" : "Start a scoping call"}</span>
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Coming 2027 -->
    <section class="section">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab">
        <div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div>
      </div>
      <div class="container">
        <div class="section-wrapper-vertical section-wrapper-vertical-large">
          <div class="heading-horizontal">
            <div class="heading-horizontal-inner">
              <div class="heading-horizontal-left-part">
                <h2 class="heading">Year 2 — 2027 roadmap</h2>
              </div>
              <div class="heading-horizontal-right-part">
                <p class="text-medium">Planned additions. Join a waitlist and we'll email you 30 days before launch.</p>
              </div>
            </div>
          </div>

          <div class="soon-grid">
            {comingY2.map((svc) => (
              <div class="soon-card" data-service-slug={svc.slug}>
                <div class="soon-card-head">
                  <span class="soon-badge soon-badge-2027">2027</span>
                </div>
                <h3 class="soon-title">{svc.title}</h3>
                <p class="soon-desc">{svc.desc}</p>
                <form class="soon-form" data-waitlist-form data-service-slug={svc.slug} data-service-year="2027">
                  <input type="email" name="email" placeholder="you@company.com" aria-label={`Email for ${svc.title} waitlist`} required />
                  <button type="submit" class="soon-btn">Add me to 2027 waitlist →</button>
                  <p class="soon-msg" aria-live="polite"></p>
                </form>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Coming 2028 -->
    <section class="section bg-color-dark">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab">
        <div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div>
      </div>
      <div class="container">
        <div class="section-wrapper-vertical section-wrapper-vertical-large">
          <div class="heading-horizontal">
            <div class="heading-horizontal-inner">
              <div class="heading-horizontal-left-part">
                <h2 class="heading">Year 3 — 2028 roadmap</h2>
              </div>
              <div class="heading-horizontal-right-part">
                <p class="text-medium">Advanced and managed services. The roadmap is real; the certs and hires to deliver them follow in Year 2 – 3.</p>
              </div>
            </div>
          </div>

          <div class="soon-grid">
            {comingY3.map((svc) => (
              <div class="soon-card" data-service-slug={svc.slug}>
                <div class="soon-card-head">
                  <span class="soon-badge soon-badge-2028">2028</span>
                </div>
                <h3 class="soon-title">{svc.title}</h3>
                <p class="soon-desc">{svc.desc}</p>
                <form class="soon-form" data-waitlist-form data-service-slug={svc.slug} data-service-year="2028">
                  <input type="email" name="email" placeholder="you@company.com" aria-label={`Email for ${svc.title} waitlist`} required />
                  <button type="submit" class="soon-btn">Add me to 2028 waitlist →</button>
                  <p class="soon-msg" aria-live="polite"></p>
                </form>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Why Offensive Security matters for UAE -->
    <section class="section">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab">
        <div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div>
      </div>
      <div class="container-medium">
        <div class="section-wrapper-vertical">
          <div class="heading-horizontal">
            <div class="heading-horizontal-inner">
              <div class="heading-horizontal-left-part">
                <h2 class="heading">Why this matters for UAE</h2>
              </div>
              <div class="heading-horizontal-right-part">
                <p class="text-medium">Scanners find patterns. Pen tests find paths.</p>
              </div>
            </div>
          </div>
          <div class="why-uae-body">
            <p>Every UAE enterprise onboarding process — banks, tender committees, enterprise procurement — asks for penetration-test evidence before contract. Most UAE mid-market companies respond with a <em>vulnerability scan PDF</em>. That's not what auditors and procurement teams are asking for, and it's not what keeps you safe.</p>
            <p>We deliver the real thing: <strong>manual, methodical, exploit-driven testing</strong> by named OSCP, CPTS, and CEH practitioners. Scanners and automation are part of the toolkit — but tools don't write the report or decide what to exploit next. Our testers do.</p>
            <p>Every engagement ends with a live walkthrough of findings and a <strong>free re-test of critical and high findings within 30 days of remediation</strong>.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="section bg-color-dark">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab">
        <div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div>
      </div>
      <div class="container-medium">
        <div class="section-wrapper-vertical" style="align-items:center;text-align:center;">
          <h2 class="heading" style="max-width:560px;">Enterprise client asked for a pen test report? Audit coming up?</h2>
          <p class="text-medium" style="max-width:580px;">
            Book a free 30-minute scoping call. We'll scope your engagement, send a written quote within 48 hours, and walk you through exactly what you'll get.
          </p>
          <div class="button">
            <a href="/#contact?service=offensive-security" class="button-hidden w-button">Book a Free Scoping Call</a>
            <div class="button-wrapper">
              <div class="button-text">Book a Free Scoping Call</div>
            </div>
            <div class="button-accent-gradinet"></div>
          </div>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>

<script src="/js/waitlist.js" defer></script>
