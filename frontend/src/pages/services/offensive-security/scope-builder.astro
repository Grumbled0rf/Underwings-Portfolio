---
// ===========================================
// Offensive Security — Scope Builder Wizard (v2 design)
// 4-step interactive qualifier that outputs a personalised
// scope brief + captures email → Krayin CRM + auto-reply HTML.
// ===========================================

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import '../../../styles/category-hub.css';
import '../../../styles/offensive-hub.css';
import '../../../styles/scope-builder.css';

export const prerender = false;

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || process.env.PUBLIC_TURNSTILE_SITE_KEY || '';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://underwings.org" },
      { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://underwings.org/services" },
      { "@type": "ListItem", "position": 3, "name": "Offensive Security", "item": "https://underwings.org/services/offensive-security" },
      { "@type": "ListItem", "position": 4, "name": "Scope Builder", "item": "https://underwings.org/services/offensive-security/scope-builder" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Penetration Testing Scope Builder",
    "applicationCategory": "BusinessApplication",
    "operatingSystem": "Any",
    "url": "https://underwings.org/services/offensive-security/scope-builder",
    "description": "Interactive scope builder for UAE penetration testing engagements. Recommends scope, compliance mapping, and indicative AED pricing in under 2 minutes.",
    "provider": { "@type": "Organization", "name": "Underwings Cybersecurity Solutions", "url": "https://underwings.org" },
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "AED", "description": "Free scoping brief" },
    "browserRequirements": "Requires JavaScript",
    "areaServed": { "@type": "Country", "name": "United Arab Emirates" }
  }
];

// Inline SVG icon set — consistent 22×22 stroke icons per answer option
const ic = {
  compliance: `<svg viewBox="0 0 22 22" fill="none" aria-hidden="true"><path d="M11 2l7 3v6c0 4-3 7-7 9-4-2-7-5-7-9V5l7-3z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M8 11l2 2 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  client:     `<svg viewBox="0 0 22 22" fill="none" aria-hidden="true"><rect x="3" y="7" width="16" height="11" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M8 7V5a2 2 0 012-2h2a2 2 0 012 2v2" stroke="currentColor" stroke-width="1.6"/><path d="M3 12h16" stroke="currentColor" stroke-width="1.6"/></svg>`,
  rocket:     `<svg viewBox="0 0 22 22" fill="none" aria-hidden="true"><path d="M14 3c3 0 5 2 5 5-1 5-5 9-10 10l-2-2C8 11 12 7 14 3z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M8 14l-4 4m4-2l-2 2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><circle cx="14.5" cy="7.5" r="1.2" stroke="currentColor" stroke-width="1.4"/></svg>`,
  alert:      `<svg viewBox="0 0 22 22" fill="none" aria-hidden="true"><path d="M11 3l9 16H2l9-16z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M11 9v4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><circle cx="11" cy="16" r="0.8" fill="currentColor"/></svg>`,
  compass:    `<svg viewBox="0 0 22 22" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="8" stroke="currentColor" stroke-width="1.6"/><path d="M14 8l-2 5-5 2 2-5 5-2z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>`,
  globe:      `<svg viewBox="0 0 22 22" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="8" stroke="currentColor" stroke-width="1.6"/><ellipse cx="11" cy="11" rx="3.5" ry="8" stroke="currentColor" stroke-width="1.6"/><path d="M3 11h16" stroke="currentColor" stroke-width="1.6"/></svg>`,
  server:     `<svg viewBox="0 0 22 22" fill="none" aria-hidden="true"><rect x="3" y="4" width="16" height="5" rx="1" stroke="currentColor" stroke-width="1.6"/><rect x="3" y="13" width="16" height="5" rx="1" stroke="currentColor" stroke-width="1.6"/><circle cx="7" cy="6.5" r="0.7" fill="currentColor"/><circle cx="7" cy="15.5" r="0.7" fill="currentColor"/></svg>`,
  window:     `<svg viewBox="0 0 22 22" fill="none" aria-hidden="true"><rect x="3" y="4" width="16" height="14" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M3 8h16" stroke="currentColor" stroke-width="1.6"/><circle cx="6" cy="6" r="0.6" fill="currentColor"/><circle cx="8.5" cy="6" r="0.6" fill="currentColor"/></svg>`,
  mobile:     `<svg viewBox="0 0 22 22" fill="none" aria-hidden="true"><rect x="6" y="2" width="10" height="18" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M10 17h2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>`,
  api:        `<svg viewBox="0 0 22 22" fill="none" aria-hidden="true"><path d="M7 6l-4 5 4 5m8-10l4 5-4 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M13 5l-4 12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>`,
  cloud:      `<svg viewBox="0 0 22 22" fill="none" aria-hidden="true"><path d="M6 16a4 4 0 010-8 5 5 0 019-1 4 4 0 012 8H6z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>`,
  hook:       `<svg viewBox="0 0 22 22" fill="none" aria-hidden="true"><path d="M6 4h10l-2 4H8l-2-4z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M11 8v6a3 3 0 01-3 3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><circle cx="8" cy="17" r="0.8" fill="currentColor"/></svg>`,
  scan:       `<svg viewBox="0 0 22 22" fill="none" aria-hidden="true"><circle cx="10" cy="10" r="6" stroke="currentColor" stroke-width="1.6"/><path d="M14.5 14.5L19 19" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M7 10h6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>`,
  bolt:       `<svg viewBox="0 0 22 22" fill="none" aria-hidden="true"><path d="M12 2l-7 11h5l-1 7 7-11h-5l1-7z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>`,
  calendar:   `<svg viewBox="0 0 22 22" fill="none" aria-hidden="true"><rect x="3" y="5" width="16" height="14" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M3 9h16M7 3v4M15 3v4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>`,
  clock:      `<svg viewBox="0 0 22 22" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="8" stroke="currentColor" stroke-width="1.6"/><path d="M11 6v5l3 2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>`,
  binoc:      `<svg viewBox="0 0 22 22" fill="none" aria-hidden="true"><circle cx="6" cy="14" r="3" stroke="currentColor" stroke-width="1.6"/><circle cx="16" cy="14" r="3" stroke="currentColor" stroke-width="1.6"/><path d="M9 14v-6a2 2 0 014 0v6" stroke="currentColor" stroke-width="1.6"/></svg>`,
  sprout:     `<svg viewBox="0 0 22 22" fill="none" aria-hidden="true"><path d="M11 19V10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M11 10c-3 0-5-2-5-5 3 0 5 2 5 5zm0 0c3 0 5-2 5-5-3 0-5 2-5 5z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>`,
  people:     `<svg viewBox="0 0 22 22" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="3" stroke="currentColor" stroke-width="1.6"/><path d="M3 18a5 5 0 0110 0" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><circle cx="15" cy="9" r="2.2" stroke="currentColor" stroke-width="1.6"/><path d="M14 18a4 4 0 015-3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>`,
  building:   `<svg viewBox="0 0 22 22" fill="none" aria-hidden="true"><rect x="4" y="5" width="14" height="14" stroke="currentColor" stroke-width="1.6"/><path d="M8 9h2M12 9h2M8 13h2M12 13h2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>`,
  enterprise: `<svg viewBox="0 0 22 22" fill="none" aria-hidden="true"><rect x="3" y="9" width="6" height="11" stroke="currentColor" stroke-width="1.6"/><rect x="10" y="3" width="9" height="17" stroke="currentColor" stroke-width="1.6"/><path d="M13 8h3M13 12h3M13 16h3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>`,
};
---

<Layout
  title="Penetration Testing Scope Builder | Underwings"
  description="Answer 4 questions, get a UAE pen test scope recommendation, indicative AED pricing and compliance mapping — emailed to you in 2 minutes. OSCP/CPTS-led."
  keywords="pen test cost calculator UAE, penetration testing quote Dubai, pen test scope wizard, cybersecurity pricing calculator UAE"
  ogImage="/images/logowhiteUW.png"
  wfPage="services-page"
  schema={schema}
  bodyClass="body svc-compact"
>
  <Header currentPage="services" />

  <main id="main" class="main sb-main">

    <!-- Ambient background — subtle blueprint grid + glow spots -->
    <div class="sb-atmos" aria-hidden="true">
      <div class="sb-grid"></div>
      <div class="sb-glow sb-glow-1"></div>
      <div class="sb-glow sb-glow-2"></div>
    </div>

    <section class="section bottom-padding-clear top-padding-small">
      <div class="container-medium">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><span aria-hidden="true">›</span>
          <a href="/services">Services</a><span aria-hidden="true">›</span>
          <a href="/services/offensive-security">Offensive Security</a><span aria-hidden="true">›</span>
          <span class="crumbs-current">Scope Builder</span>
        </nav>

        <div class="sb-hero">
          <a href="/" class="sb-hero-brand" aria-label="Underwings home">
            <picture>
              <source srcset="/images/logowhiteUW.webp" type="image/webp" />
              <img src="/images/logowhiteUW.png" alt="Underwings" width="128" height="32" />
            </picture>
            <span class="sb-hero-brand-sep"></span>
            <span class="sb-hero-brand-label">Penetration Testing Scope Builder</span>
          </a>
          <div class="sb-hero-label">
            <span class="sb-hero-tick">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 7l3 3 5-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <span>4 questions · 2 minutes · no signup required</span>
          </div>
          <h1 class="sb-hero-title">Not sure what you need?<br/><span class="text-gradient-clip bg-color-green-gradient">Let's figure it out.</span></h1>
          <p class="sb-hero-sub">
            Answer four questions and we'll recommend the right penetration testing scope, indicative pricing in AED, and map it to your compliance framework. You'll get a written scoping brief emailed to you — no sales call required to see the numbers.
          </p>
        </div>
      </div>
    </section>

    <!-- Wizard shell (form + sidebar on desktop) -->
    <section class="section top-padding-clear sb-wizard-sec">
      <div class="container-medium">

        <!-- Step indicator — numbered circles + connector -->
        <div class="sb-steps" role="progressbar" aria-valuemin="0" aria-valuemax="5" aria-valuenow="1" id="sb-progress">
          <div class="sb-steps-rail"><div class="sb-steps-rail-fill" id="sb-rail-fill"></div></div>
          <ol class="sb-steps-list">
            <li class="sb-step-node active" data-step="1"><span class="sb-step-dot">1</span><span class="sb-step-label">Driver</span></li>
            <li class="sb-step-node" data-step="2"><span class="sb-step-dot">2</span><span class="sb-step-label">Assets</span></li>
            <li class="sb-step-node" data-step="3"><span class="sb-step-dot">3</span><span class="sb-step-label">Timeline</span></li>
            <li class="sb-step-node" data-step="4"><span class="sb-step-dot">4</span><span class="sb-step-label">Size</span></li>
            <li class="sb-step-node" data-step="5"><span class="sb-step-dot"><svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2 6l3 3 5-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span class="sb-step-label">Your brief</span></li>
          </ol>
        </div>

        <div class="sb-layout">

          <!-- Main wizard column -->
          <form id="sb-form" class="sb-form" novalidate>

            <!-- ── STEP 1 — Driver ─────────────────────────────── -->
            <fieldset class="sb-panel active" data-panel="1">
              <legend class="sb-q">What's driving this engagement?</legend>
              <p class="sb-q-hint">Pick the one that best describes why you're here. We'll use this to prioritise the scope recommendation.</p>

              <div class="sb-options">
                <label class="sb-option">
                  <input type="radio" name="driver" value="compliance" />
                  <div class="sb-option-ico" set:html={ic.compliance}></div>
                  <div class="sb-option-body">
                    <strong>Compliance or audit</strong>
                    <span>ISO 27001, UAE IA V2, ADHICS, PCI DSS, SOC 2 — auditor or standard requires it.</span>
                  </div>
                  <span class="sb-option-check">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 7l3 3 5-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </span>
                </label>

                <label class="sb-option">
                  <input type="radio" name="driver" value="client_request" />
                  <div class="sb-option-ico" set:html={ic.client}></div>
                  <div class="sb-option-body">
                    <strong>Enterprise client asked for it</strong>
                    <span>Bank, government, or large corporate wants a pen test report before contract.</span>
                  </div>
                  <span class="sb-option-check"><svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 7l3 3 5-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                </label>

                <label class="sb-option">
                  <input type="radio" name="driver" value="product_launch" />
                  <div class="sb-option-ico" set:html={ic.rocket}></div>
                  <div class="sb-option-body">
                    <strong>Shipping a new product</strong>
                    <span>New web app, mobile app, or major release going live — security gate before launch.</span>
                  </div>
                  <span class="sb-option-check"><svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 7l3 3 5-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                </label>

                <label class="sb-option">
                  <input type="radio" name="driver" value="incident" />
                  <div class="sb-option-ico" set:html={ic.alert}></div>
                  <div class="sb-option-body">
                    <strong>Had an incident or close call</strong>
                    <span>Suspicious activity, credential stuffing, responsible-disclosure report — need external assurance.</span>
                  </div>
                  <span class="sb-option-check"><svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 7l3 3 5-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                </label>

                <label class="sb-option">
                  <input type="radio" name="driver" value="unsure" />
                  <div class="sb-option-ico" set:html={ic.compass}></div>
                  <div class="sb-option-body">
                    <strong>Just exploring / not sure</strong>
                    <span>Good governance, want to know where we stand. We'll recommend a balanced scope.</span>
                  </div>
                  <span class="sb-option-check"><svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 7l3 3 5-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                </label>
              </div>

              <!-- Sub-question: framework -->
              <div class="sb-subq" id="sb-subq-framework" hidden>
                <p class="sb-q-sub">Which compliance framework?</p>
                <div class="sb-chip-options">
                  <label class="sb-chip-opt"><input type="radio" name="framework" value="iso27001"/><span>ISO 27001</span></label>
                  <label class="sb-chip-opt"><input type="radio" name="framework" value="uae_ia"/><span>UAE IA V2</span></label>
                  <label class="sb-chip-opt"><input type="radio" name="framework" value="adhics"/><span>ADHICS (Healthcare)</span></label>
                  <label class="sb-chip-opt"><input type="radio" name="framework" value="pci_dss"/><span>PCI DSS</span></label>
                  <label class="sb-chip-opt"><input type="radio" name="framework" value="soc2"/><span>SOC 2</span></label>
                  <label class="sb-chip-opt"><input type="radio" name="framework" value="other"/><span>Other / not sure</span></label>
                </div>
              </div>

              <div class="sb-nav">
                <span></span>
                <button type="button" class="sb-btn sb-btn-primary" data-next="2" disabled>Continue <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M3 7h8M7 3l4 4-4 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
              </div>
            </fieldset>

            <!-- ── STEP 2 — Assets ─────────────────────────────── -->
            <fieldset class="sb-panel" data-panel="2">
              <legend class="sb-q">What attack surface do you have?</legend>
              <p class="sb-q-hint">Select every asset category you want tested. Counts help us size the engagement accurately.</p>

              <div class="sb-assets">

                <label class="sb-asset">
                  <input type="checkbox" name="asset_network_ext" value="1"/>
                  <div class="sb-asset-ico" set:html={ic.globe}></div>
                  <div class="sb-asset-body">
                    <strong>External network</strong>
                    <span>Internet-exposed perimeter — firewalls, VPN, public services.</span>
                  </div>
                  <span class="sb-option-check"><svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2 6l3 3 5-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                </label>

                <label class="sb-asset">
                  <input type="checkbox" name="asset_network_int" value="1"/>
                  <div class="sb-asset-ico" set:html={ic.server}></div>
                  <div class="sb-asset-body">
                    <strong>Internal network / AD</strong>
                    <span>Corporate LAN, Active Directory, lateral movement test.</span>
                  </div>
                  <span class="sb-option-check"><svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2 6l3 3 5-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                </label>

                <label class="sb-asset">
                  <input type="checkbox" name="asset_web" value="1" data-count-trigger="asset_web_count"/>
                  <div class="sb-asset-ico" set:html={ic.window}></div>
                  <div class="sb-asset-body">
                    <strong>Web applications</strong>
                    <span>Customer-facing or internal web apps, dashboards, portals.</span>
                    <div class="sb-asset-count" data-count-for="asset_web_count" hidden>
                      <label>How many? <input type="number" name="asset_web_count" min="1" max="20" value="1" /></label>
                    </div>
                  </div>
                  <span class="sb-option-check"><svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2 6l3 3 5-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                </label>

                <label class="sb-asset">
                  <input type="checkbox" name="asset_mobile" value="1" data-count-trigger="asset_mobile_platform"/>
                  <div class="sb-asset-ico" set:html={ic.mobile}></div>
                  <div class="sb-asset-body">
                    <strong>Mobile apps (iOS / Android)</strong>
                    <span>OWASP MASTG / MASVS methodology.</span>
                    <div class="sb-asset-count" data-count-for="asset_mobile_platform" hidden>
                      <div class="sb-radios">
                        <label><input type="radio" name="asset_mobile_platform" value="ios"/> iOS only</label>
                        <label><input type="radio" name="asset_mobile_platform" value="android"/> Android only</label>
                        <label><input type="radio" name="asset_mobile_platform" value="both"/> Both</label>
                      </div>
                    </div>
                  </div>
                  <span class="sb-option-check"><svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2 6l3 3 5-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                </label>

                <label class="sb-asset">
                  <input type="checkbox" name="asset_api" value="1"/>
                  <div class="sb-asset-ico" set:html={ic.api}></div>
                  <div class="sb-asset-body">
                    <strong>Standalone API</strong>
                    <span>REST, GraphQL, or SOAP API not tied to a web app.</span>
                  </div>
                  <span class="sb-option-check"><svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2 6l3 3 5-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                </label>

                <label class="sb-asset">
                  <input type="checkbox" name="asset_cloud" value="1" data-count-trigger="asset_cloud_count"/>
                  <div class="sb-asset-ico" set:html={ic.cloud}></div>
                  <div class="sb-asset-body">
                    <strong>Cloud accounts</strong>
                    <span>AWS, Azure, or GCP configuration review.</span>
                    <div class="sb-asset-count" data-count-for="asset_cloud_count" hidden>
                      <label>How many providers? <input type="number" name="asset_cloud_count" min="1" max="3" value="1" /></label>
                    </div>
                  </div>
                  <span class="sb-option-check"><svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2 6l3 3 5-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                </label>

                <label class="sb-asset">
                  <input type="checkbox" name="asset_phishing" value="1" data-count-trigger="asset_phishing_count"/>
                  <div class="sb-asset-ico" set:html={ic.hook}></div>
                  <div class="sb-asset-body">
                    <strong>Phishing simulation</strong>
                    <span>Controlled campaign against your employees.</span>
                    <div class="sb-asset-count" data-count-for="asset_phishing_count" hidden>
                      <label>Approx. employees? <input type="number" name="asset_phishing_count" min="10" max="10000" value="100" /></label>
                    </div>
                  </div>
                  <span class="sb-option-check"><svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2 6l3 3 5-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                </label>

                <label class="sb-asset">
                  <input type="checkbox" name="asset_va_only" value="1"/>
                  <div class="sb-asset-ico" set:html={ic.scan}></div>
                  <div class="sb-asset-body">
                    <strong>Just a vulnerability scan</strong>
                    <span>Budget-tight compliance box-check. Scan-and-report, no exploitation.</span>
                  </div>
                  <span class="sb-option-check"><svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2 6l3 3 5-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                </label>

              </div>

              <div class="sb-nav">
