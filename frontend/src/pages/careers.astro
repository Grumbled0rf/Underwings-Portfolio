---
// ===========================================
// CAREERS / JOIN US PAGE
// Underwings Cybersecurity Solutions
// ===========================================

export const prerender = false;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { supabase } from '../lib/supabase';

// Fetch career openings from Supabase (active + future only via RLS)
let positions: Array<{title: string; location: string; description: string; requirements: string[]; status: string}> = [];
try {
  const { data } = await supabase
    .from('career_openings')
    .select('title, location, description, requirements, status')
    .order('display_order', { ascending: true });
  if (data) positions = data;
} catch {
  // Fallback: page renders with empty positions
}

const activeCount = positions.filter(p => p.status === 'active').length;
const totalCount = positions.length;

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://underwings.org" },
      { "@type": "ListItem", "position": 2, "name": "Careers", "item": "https://underwings.org/careers" }
    ]
  }
];
---

<Layout
  title="Careers – Join the Underwings Team | Cybersecurity Jobs UAE"
  description="Join Underwings Cybersecurity Solutions. We're hiring penetration testers, security consultants, developers, and sales professionals in UAE. Remote-first, startup culture."
  keywords="cybersecurity jobs, penetration tester jobs UAE, security consultant UAE, infosec careers, cybersecurity startup jobs"
  wfPage="careers-page"
  schema={schema}
  bodyClass="body"
>
  <Header currentPage="careers" />

  <main id="main" class="main">
    <!-- Hero Section -->
    <section class="section bottom-padding-clear top-padding-small">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab">
        <div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div>
      </div>
      <div class="container-medium">
        <div class="hero">
          <div class="hero-main-wrapper">
            <div class="hero-heading-wrapper">
              <div class="label">
                <div class="text-small color-grey">Careers</div>
              </div>
              <h1 class="heading-large hero-heading-large">Join the <span class="text-gradient-clip bg-color-green-gradient">Underwings</span> Team</h1>
              <p class="text text-center car-hero-subtitle">Build the future of cybersecurity with us. We're a growing startup based in the UAE, making real security accessible to businesses everywhere.</p>
              <div class="car-hero-cta">
                <div class="button">
                  <a href="#open-positions" class="button-hidden w-button">View Openings</a>
                  <div class="button-wrapper">
                    <div class="button-text">View Openings</div>
                  </div>
                  <div class="button-accent-gradinet"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <!-- Hero Stats -->
        <div class="car-hero-stats">
          <div class="car-stat car-stagger">
            <div class="car-stat-number">{totalCount}</div>
            <div class="car-stat-label">Open Roles</div>
          </div>
          <div class="car-stat-divider"></div>
          <div class="car-stat car-stagger">
            <div class="car-stat-number">3+</div>
            <div class="car-stat-label">Countries</div>
          </div>
          <div class="car-stat-divider"></div>
          <div class="car-stat car-stagger">
            <div class="car-stat-number">100%</div>
            <div class="car-stat-label">Remote-First</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Why Join Us -->
    <section class="section bg-color-dark">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab">
        <div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div>
      </div>
      <div class="container">
        <div class="vertical-heading-top">
          <div class="label">
            <div class="text-small color-grey">Why Join Us</div>
          </div>
          <h2 class="heading heading-center">Why <span class="text-gradient-clip bg-color-green-gradient">Underwings</span></h2>
          <div class="car-why-grid">
            <div class="car-why-card car-stagger">
              <div class="car-why-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              </div>
              <div class="car-why-number">01</div>
              <h3 class="car-card-title">Small Team, Big Impact</h3>
              <p class="car-card-desc">No layers of bureaucracy. Your work directly shapes our products, services, and client outcomes. Every person here matters.</p>
            </div>
            <div class="car-why-card car-stagger">
              <div class="car-why-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L4 6v6c0 5.5 3.5 8.5 8 10 4.5-1.5 8-4.5 8-10V6l-8-4z"/></svg>
              </div>
              <div class="car-why-number">02</div>
              <h3 class="car-card-title">Work on Real Engagements</h3>
              <p class="car-card-desc">From day one, you'll work on live pentests, real compliance projects, and production security tools — not theoretical exercises.</p>
            </div>
            <div class="car-why-card car-stagger">
              <div class="car-why-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
              </div>
              <div class="car-why-number">03</div>
              <h3 class="car-card-title">Remote-First & Flexible</h3>
              <p class="car-card-desc">Work from anywhere. We care about output, not hours logged. Async communication, flexible schedules, and trust by default.</p>
            </div>
            <div class="car-why-card car-stagger">
              <div class="car-why-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              </div>
              <div class="car-why-number">04</div>
              <h3 class="car-card-title">Startup Culture with Purpose</h3>
              <p class="car-card-desc">We're building something meaningful — making cybersecurity accessible to businesses that can't afford the Big 4. Growth, ownership, and real purpose.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Open Positions -->
    <section id="open-positions" class="section">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab">
        <div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div>
      </div>
      <div class="container">
        <div class="vertical-heading-top">
          <div class="label">
            <div class="text-small color-grey">Opportunities</div>
          </div>
          <h2 class="heading heading-center">Open <span class="text-gradient-clip bg-color-green-gradient">Positions</span></h2>
          <p class="text-medium color-grey car-positions-subtitle">These roles are planned as we grow. If something catches your eye, reach out early — we'd love to hear from you.</p>

          {positions.length > 0 ? (
            <div class="car-positions-list">
              {positions.map((pos, i) => (
                <div class="car-pos car-stagger">
                  <div class="car-pos-left">
                    <div class="car-pos-index">{String(i + 1).padStart(2, '0')}</div>
                  </div>
                  <div class="car-pos-main">
                    <div class="car-pos-top-row">
                      <h3 class="car-pos-title">{pos.title}</h3>
                      <div class="car-pos-tags">
                        <span class={pos.status === 'active' ? 'car-tag-active' : 'car-tag-future'}>{pos.status === 'active' ? 'Now Hiring' : 'Future Opening'}</span>
                        <span class="car-tag-location">
                          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                          {pos.location}
                        </span>
                      </div>
                    </div>
                    <p class="car-pos-desc">{pos.description}</p>
                    <div class="car-pos-bottom">
                      <ul class="car-pos-reqs">
                        {pos.requirements.map((req) => (
                          <li>{req}</li>
                        ))}
                      </ul>
                      <a href={`mailto:careers@underwings.org?subject=Interest: ${pos.title}`} class="car-pos-apply">
                        <span>Express Interest</span>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                      </a>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          ) : (
            <div class="car-empty">
              <p>No open positions at the moment. Check back soon, or send your CV to <a href="mailto:careers@underwings.org">careers@underwings.org</a>.</p>
            </div>
          )}
        </div>
      </div>
    </section>

    <!-- What We Look For -->
    <section class="section bg-color-dark">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab">
        <div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div>
      </div>
      <div class="container">
        <div class="vertical-heading-top">
          <div class="label">
            <div class="text-small color-grey">Our Values</div>
          </div>
          <h2 class="heading heading-center">What We <span class="text-gradient-clip bg-color-green-gradient">Look For</span></h2>
          <div class="car-values-grid">
            <div class="car-value-card car-stagger">
              <div class="car-value-icon-wrap">
                <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true"><circle cx="14" cy="14" r="9" stroke="currentColor" stroke-width="1.5"/><path d="M14 10v4l2.5 2.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M10 5l-2-2M18 5l2-2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              </div>
              <h3 class="car-card-title">Curiosity</h3>
              <p class="car-card-desc">You ask "why" and "what if" constantly. You dig into problems, read RFCs for fun, and never stop learning.</p>
            </div>
            <div class="car-value-card car-stagger">
              <div class="car-value-icon-wrap">
                <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true"><path d="M14 24s8-4 8-10V8l-8-4-8 4v6c0 6 8 10 8 10z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M10 14l3 3 5-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </div>
              <h3 class="car-card-title">Honesty</h3>
              <p class="car-card-desc">We tell clients the truth, even when it's uncomfortable. Integrity is non-negotiable in security work.</p>
            </div>
            <div class="car-value-card car-stagger">
              <div class="car-value-icon-wrap">
                <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true"><path d="M13 4L3 14h9l-1 10 10-12h-9l1-8z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </div>
              <h3 class="car-card-title">Self-Starters</h3>
              <p class="car-card-desc">You don't wait to be told what to do. You see a gap, you fill it. Ownership and initiative are in your DNA.</p>
            </div>
            <div class="car-value-card car-stagger">
              <div class="car-value-icon-wrap">
                <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true"><path d="M10 18s1.5 2 4 2 4-2 4-2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><circle cx="10" cy="12" r="1.5" fill="currentColor"/><circle cx="18" cy="12" r="1.5" fill="currentColor"/><circle cx="14" cy="14" r="10" stroke="currentColor" stroke-width="1.5"/></svg>
              </div>
              <h3 class="car-card-title">Passion for Security</h3>
              <p class="car-card-desc">Whether it's CTFs, bug bounties, open-source tools, or compliance frameworks — you genuinely care about making things secure.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- How to Apply CTA -->
    <section id="cta" class="section bg-color-grey-gradient">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab">
        <div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div>
      </div>
      <div class="container">
        <div class="vertical-heading-top" style="text-align: center;">
          <div class="label">
            <div class="text-small color-grey">How to Apply</div>
          </div>
          <h2 class="heading heading-center">Ready to <span class="text-gradient-clip bg-color-green-gradient">Join?</span></h2>
          <p class="text-medium car-cta-text">Send your CV and a short note about why you want to join Underwings. Tell us what excites you about cybersecurity and what you'd bring to the team.</p>

          <div class="car-cta-steps">
            <div class="car-cta-step car-stagger">
              <div class="car-cta-step-num">1</div>
              <div class="car-cta-step-text">Send your CV & cover note</div>
            </div>
            <div class="car-cta-step-arrow">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </div>
            <div class="car-cta-step car-stagger">
              <div class="car-cta-step-num">2</div>
              <div class="car-cta-step-text">Quick intro call</div>
            </div>
            <div class="car-cta-step-arrow">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </div>
            <div class="car-cta-step car-stagger">
              <div class="car-cta-step-num">3</div>
              <div class="car-cta-step-text">Technical discussion or task</div>
            </div>
            <div class="car-cta-step-arrow">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </div>
            <div class="car-cta-step car-stagger">
              <div class="car-cta-step-num">&check;</div>
              <div class="car-cta-step-text">Welcome aboard</div>
            </div>
          </div>

          <div class="car-cta-email">
            <a href="mailto:careers@underwings.org" class="car-email-link">careers@underwings.org</a>
          </div>
          <p class="text-medium color-grey car-cta-alt">You can also reach out to us on <a href="https://www.linkedin.com/company/underwings-technologies" target="_blank" rel="nofollow noopener noreferrer" class="car-linkedin-link">LinkedIn</a> — we'd love to connect.</p>
          <div class="car-hero-cta">
            <div class="button" style="display: inline-block;">
              <a href="mailto:careers@underwings.org" class="button-hidden w-button">Send Your Application</a>
              <div class="button-wrapper">
                <div class="button-text">Send Your Application</div>
              </div>
              <div class="button-accent-gradinet"></div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style is:inline>
  /* ---- Hero ---- */
  .car-hero-subtitle {
    max-width: 680px;
    margin: 1.5rem auto;
  }
  .car-hero-cta {
    margin-top: 2rem;
  }

  /* ---- Hero Stats ---- */
  .car-hero-stats {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2.5rem;
    margin-top: 3.5rem;
    padding: 2rem 0;
    border-top: 1px dashed rgba(255,255,255,0.08);
    border-bottom: 1px dashed rgba(255,255,255,0.08);
  }
  .car-stat {
    text-align: center;
  }
  .car-stat-number {
    font-family: 'Geist', sans-serif;
    font-size: 2.25rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    background: linear-gradient(135deg, #24d758, #27dab4);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1.1;
  }
  .car-stat-label {
    font-size: 0.75rem;
    color: rgba(255,255,255,0.4);
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin-top: 0.4rem;
    font-family: 'Geist Mono', monospace;
  }
  .car-stat-divider {
    width: 1px;
    height: 40px;
    background: rgba(255,255,255,0.08);
  }
  @media (max-width: 480px) {
    .car-hero-stats { gap: 1.5rem; }
    .car-stat-number { font-size: 1.75rem; }
  }

  /* ---- Why Join Us grid ---- */
  .car-why-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
    margin-top: 3rem;
  }
  .car-why-card {
    padding: 2rem 1.75rem;
    background: rgba(255,255,255,0.02);
    border: 1px dashed rgba(255,255,255,0.1);
    border-radius: 14px;
    transition: border-color 0.3s ease, background 0.3s ease;
    position: relative;
  }
  .car-why-card:hover {
    border-color: rgba(36,215,88,0.3);
    border-style: solid;
    background: rgba(36,215,88,0.02);
  }
  .car-why-icon {
    color: #24d758;
    margin-bottom: 1rem;
    opacity: 0.7;
  }
  .car-why-number {
    font-size: 1.5rem;
    font-weight: 700;
    font-family: 'Geist Mono', monospace;
    background: linear-gradient(135deg, #24d758, #27dab4);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 0.6rem;
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .car-card-title {
    font-family: 'Geist', sans-serif;
    font-size: 1.15rem;
    font-weight: 600;
    color: #fff;
    margin-bottom: 0.6rem;
    letter-spacing: -0.02em;
  }
  .car-card-desc {
    font-size: 0.875rem;
    color: rgba(255,255,255,0.55);
    line-height: 1.6;
  }
  @media (max-width: 600px) {
    .car-why-grid { grid-template-columns: 1fr; }
  }

  /* ---- Open Positions (new list layout) ---- */
  .car-positions-subtitle {
    max-width: 620px;
    margin: 1rem auto 0;
    text-align: center;
  }
  .car-positions-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 3rem;
  }
  .car-pos {
    display: flex;
    gap: 1.5rem;
    padding: 2rem;
    background: rgba(255,255,255,0.02);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 14px;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
    position: relative;
    overflow: hidden;
  }
  .car-pos::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 3px;
    height: 100%;
    background: linear-gradient(180deg, #24d758, #27dab4);
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .car-pos:hover {
    border-color: rgba(36,215,88,0.2);
    box-shadow: 0 4px 24px rgba(36,215,88,0.04);
  }
  .car-pos:hover::before {
    opacity: 1;
  }
  .car-pos-left {
    flex-shrink: 0;
    display: flex;
    align-items: flex-start;
    padding-top: 0.25rem;
  }
  .car-pos-index {
    font-family: 'Geist Mono', monospace;
    font-size: 1.5rem;
    font-weight: 700;
    background: linear-gradient(135deg, #24d758, #27dab4);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .car-pos-main {
    flex: 1;
    min-width: 0;
  }
  .car-pos-top-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }
  .car-pos-title {
    font-family: 'Geist', sans-serif;
    font-size: 1.25rem;
    font-weight: 600;
    color: #fff;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .car-pos-tags {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    flex-shrink: 0;
  }
  .car-tag-future {
    font-size: 0.68rem;
    padding: 0.25rem 0.65rem;
    background: rgba(255,180,0,0.08);
    border: 1px solid rgba(255,180,0,0.25);
    border-radius: 20px;
    color: #ffb400;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    font-family: 'Geist Mono', monospace;
  }
  .car-tag-active {
    font-size: 0.68rem;
    padding: 0.25rem 0.65rem;
    background: rgba(36,215,88,0.08);
    border: 1px solid rgba(36,215,88,0.25);
    border-radius: 20px;
    color: #24d758;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    font-family: 'Geist Mono', monospace;
  }
  .car-tag-location {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.72rem;
    color: rgba(255,255,255,0.45);
    font-family: 'Geist Mono', monospace;
  }
  .car-tag-location svg {
    opacity: 0.5;
  }
  .car-pos-desc {
    font-size: 0.9rem;
    color: rgba(255,255,255,0.55);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }
  .car-pos-bottom {
