---
// ===========================================
// PARTNER LOGOS GRID
// Underwings Cybersecurity Solutions
// Fetches from Supabase, falls back to hardcoded
// ===========================================

export interface Props {
  size?: 'small' | 'large';
  linkTo?: string;
}

const { size = 'small', linkTo = '#' } = Astro.props;
const logoHeight = size === 'large' ? 36 : 30;

interface Partner {
  id: string;
  name: string;
  logo_url: string;
  website_url?: string;
  display_order: number;
  invert_logo: boolean;
}

// Partners are hidden until we have official channel partner agreements.
// Once approved, add them via the admin dashboard (which writes to the partners table)
// or temporarily seed via SQL: see /supabase/migrations/003_partners.sql
let partners: Partner[] = [];

try {
  const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || 'http://kong:8000';
  const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
  if (supabaseKey) {
    const res = await fetch(
      `${supabaseUrl}/rest/v1/partners?select=id,name,logo_url,website_url,display_order,invert_logo&is_visible=eq.true&order=display_order.asc`,
      {
        headers: {
          'apikey': supabaseKey,
          'Authorization': `Bearer ${supabaseKey}`,
        },
      }
    );
    if (res.ok) {
      const data = await res.json();
      if (data.length > 0) partners = data;
    }
  }
} catch {
  // Use fallback
}
---

{partners.map((p) => (
  <a href={linkTo} class={`partner-logo ${p.invert_logo ? 'partner-logo--invert' : ''}`} title={p.name}>
    <img src={p.logo_url} alt={p.name} loading="lazy" style={`height: ${logoHeight}px; width: auto;`}>
  </a>
))}

<style is:inline>
  .partner-logo {
    opacity: 0.7;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .partner-logo--invert {
    filter: brightness(0) invert(1);
  }
  .partner-logo:hover {
    opacity: 1;
    filter: drop-shadow(0 0 12px rgba(36,215,88,0.6));
  }
  .partner-logo--invert:hover {
    opacity: 1;
    filter: brightness(0) invert(1) drop-shadow(0 0 12px rgba(36,215,88,0.6));
  }
</style>
