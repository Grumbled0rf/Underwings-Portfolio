---
// ===========================================
// PARTNER LOGOS GRID
// Underwings Cybersecurity Solutions
// Fetches from Supabase, falls back to hardcoded
// ===========================================

export interface Props {
  size?: 'small' | 'large';
  linkTo?: string;
}

const { size = 'small', linkTo = '#' } = Astro.props;
const logoHeight = size === 'large' ? 52 : 44;

// Normalise a partner name to a slug so per-logo CSS can nudge logos whose
// source image carries extra internal padding (e.g. Sprinto/Sophos render
// visually smaller than Hexnode/TISS at the same pixel height).
const slugify = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

interface Partner {
  id: string;
  name: string;
  logo_url: string;
  website_url?: string;
  display_order: number;
  invert_logo: boolean;
}

// Partners are hidden until we have official channel partner agreements.
// Once approved, add them via the admin dashboard (which writes to the partners table)
// or temporarily seed via SQL: see /supabase/migrations/003_partners.sql
let partners: Partner[] = [];

try {
  const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || 'http://kong:8000';
  const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
  if (supabaseKey) {
    const res = await fetch(
      `${supabaseUrl}/rest/v1/partners?select=id,name,logo_url,website_url,display_order,invert_logo&is_visible=eq.true&order=display_order.asc`,
      {
        headers: {
          'apikey': supabaseKey,
          'Authorization': `Bearer ${supabaseKey}`,
        },
      }
    );
    if (res.ok) {
      const data = await res.json();
      if (data.length > 0) partners = data;
    }
  }
} catch {
  // Use fallback
}
---

{partners.map((p) => (
  <a
    href={linkTo}
    class={`partner-logo partner-logo--${slugify(p.name)} ${p.invert_logo ? 'partner-logo--invert' : ''}`}
    title={p.name}
    style={`--logo-h: ${logoHeight}px;`}
  >
    <img src={p.logo_url} alt={p.name} loading="lazy">
  </a>
))}

<style is:inline>
  .partner-logo {
    opacity: 0.7;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .partner-logo img {
    height: var(--logo-h);
    width: auto;
  }
  /* Per-logo normalisation: Sophos' source image has heavy internal padding,
     so at equal height its wordmark reads smaller than the others. Scale it up
     to match the visual weight of Hexnode / TISS. */
  .partner-logo--sophos img {
    height: calc(var(--logo-h) * 1.5);
  }
  .partner-logo--invert {
    filter: brightness(0) invert(1);
  }
  .partner-logo:hover {
    opacity: 1;
    filter: drop-shadow(0 0 12px rgba(36,215,88,0.6));
  }
  .partner-logo--invert:hover {
    opacity: 1;
    filter: brightness(0) invert(1) drop-shadow(0 0 12px rgba(36,215,88,0.6));
  }
</style>
