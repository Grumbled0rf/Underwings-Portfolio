---
// Reusable 4-tier pricing block — shared across 5 service pillars
// Styles live in styles/category-hub.css (.tier-* classes)
export interface Tier {
  name: string;          // Starter | Essentials | Professional | Enterprise
  price: string;         // "AED 9,000" or "AED 25,000–45,000"
  ideal: string;         // 1-sentence buyer description
  includes: string[];    // 3-5 bullets
  notIncluded: string[]; // 1-2 bullets
  popular?: boolean;     // visual highlight + "Most popular" badge
}
export interface Props {
  serviceSlug: string;   // contact link param
  tiers: Tier[];
  eyebrow?: string;
  heading?: string;
  sub?: string;
  starterNote?: string;  // SME note shown under Starter card
}
const {
  serviceSlug,
  tiers,
  eyebrow = "Pricing",
  heading = "Four tiers — pick your scope",
  sub = "Transparent fixed-price tiers. Every engagement is led by a named practitioner.",
  starterNote = "Designed for UAE SMEs under 30 employees. One-time engagement, no retest included.",
} = Astro.props;
---

<section class="section">
  <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab">
    <div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div>
  </div>
  <div class="container-medium">
    <div class="section-wrapper-vertical">
      <div class="tier-section">
        <p class="tier-eyebrow">{eyebrow}</p>
        <h2 class="tier-heading">{heading}</h2>
        <p class="tier-sub">{sub}</p>

        <div class="tier-grid">
          {tiers.map((t) => {
            const slug = t.name.toLowerCase();
            const cls = `tier-card${t.popular ? ' tier-card-popular' : ''}`;
            return (
              <div class={cls}>
                {t.popular && <span class="tier-popular-badge">Most popular</span>}
                <p class="tier-name">{t.name}</p>
                <p class="tier-price">{t.price}</p>
                <p class="tier-ideal"><strong>Ideal for:</strong> {t.ideal}</p>

                <div>
                  <p class="tier-section-label">Includes</p>
                  <ul class="tier-list">
                    {t.includes.map((i) => <li>{i}</li>)}
                  </ul>
                </div>

                <div>
                  <p class="tier-section-label">Not included</p>
                  <ul class="tier-list tier-list-not">
                    {t.notIncluded.map((i) => <li>{i}</li>)}
                  </ul>
                </div>

                {slug === 'starter' && <p class="tier-starter-note">{starterNote}</p>}

                <a href={`/#contact?service=${serviceSlug}&tier=${slug}`} class="tier-cta">
                  <span>Get a quote</span>
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </a>
              </div>
            );
          })}
        </div>

        <div class="tier-followup">
          <p>Not sure which tier fits?</p>
          <a href={`/#contact?service=${serviceSlug}&tier=scoping`}>
            <span>Book a 20-min scoping call</span>
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
