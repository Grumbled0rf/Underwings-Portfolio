---
export interface Props {
  body: string;
  href?: string;
  cta?: string;
}
const { body, href = '/#contact', cta = 'Discuss scope' } = Astro.props;
---
<a href={href} class="svc-scope-hint">
  <span class="svc-scope-hint-ico"><svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M3 4h12v10H3z" stroke="currentColor" stroke-width="1.4"/><path d="M3 8h12M7 12h2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg></span>
  <div class="svc-scope-hint-body"><strong>Not sure of the right scope?</strong><span set:html={body}></span></div>
  <span class="svc-scope-hint-cta">{cta} <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M3 6h6M7 3l3 3-3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
</a>
