---
export interface Props {
  currentPage?: string;
}
const { currentPage = 'home' } = Astro.props;
const nonce = Astro.locals.nonce || '';
---

<a href="#main" class="skip-to-content">Skip to content</a>

<header id="header" class="header">
  <div data-w-id="293a7602-a449-8edb-a1a4-0201d537e62c" class="header-offset"></div>
  <div
    data-w-id="c0f57989-f5a9-9c1a-60c9-2841a4ab0ea2"
    data-animation="default"
    data-collapse="medium"
    data-duration="400"
    data-easing="ease"
    data-easing2="ease"
    role="banner"
    class="navbar w-nav"
  >
    <div class="container-medium header-container-medium w-container">
      <div class="navbar-inner">

        <!-- Logo -->
        <a
          href="/"
          aria-current={currentPage === 'home' ? 'page' : undefined}
          class={`logo w-nav-brand ${currentPage === 'home' ? 'w--current' : ''}`}
        >
          <img
            src="/images/logowhiteUW.png"
            loading="lazy"
            alt="Underwings Cybersecurity Solutions"
            srcset="/images/logowhiteUW-p-500.png 500w, /images/logowhiteUW.png 639w"
            sizes="150px"
            class="logo-image"
          >
        </a>

        <!-- Desktop nav -->
        <div class="nav-menu-box uw-desktop-nav">
          <nav role="navigation" aria-label="Main navigation" class="nav-menu w-nav-menu">
            <div class="nav-menu-inner">
              <div class="nav-dropdown nav-mega-dropdown">
                <a
                  data-name="scramble"
                  href="/services"
                  aria-expanded="false"
                  aria-haspopup="true"
                  class={`nav-link nav-link-gradient w-nav-link ${currentPage === 'services' ? 'w--current' : ''}`}
                >
                  Services
                  <svg class="nav-chevron" width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
                    <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </a>
                <div class="nav-mega-content" role="menu" aria-label="Services submenu">
                  <a href="/services/vapt" class="nav-mega-item" role="menuitem">
                    <div class="nav-mega-icon" aria-hidden="true">
                      <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M10 18s6.5-3 6.5-8V5L10 2 3.5 5v5c0 5 6.5 8 6.5 8z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/></svg>
                    </div>
                    <div><span class="nav-mega-title">VAPT</span><span class="nav-mega-desc">Penetration testing & vulnerability assessment</span></div>
                  </a>
                  <a href="/services/iso-27001" class="nav-mega-item" role="menuitem">
                    <div class="nav-mega-icon" aria-hidden="true">
                      <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M10 2l2.5 5h5.5l-4.5 3.5 1.5 5.5L10 13l-5 3 1.5-5.5L2 7h5.5L10 2z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/></svg>
                    </div>
                    <div><span class="nav-mega-title">ISO 27001</span><span class="nav-mega-desc">Compliance implementation & certification</span></div>
                  </a>
                  <a href="/services/training" class="nav-mega-item" role="menuitem">
                    <div class="nav-mega-icon" aria-hidden="true">
                      <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M10 12l7-4-7-4-7 4 7 4z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/><path d="M17 8v5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/><path d="M5 10v4c0 1.1 2.2 2 5 2s5-.9 5-2v-4" stroke="currentColor" stroke-width="1.3"/></svg>
                    </div>
                    <div><span class="nav-mega-title">Training</span><span class="nav-mega-desc">Security awareness & phishing simulations</span></div>
                  </a>
                  <a href="/services/consultation" class="nav-mega-item" role="menuitem">
                    <div class="nav-mega-icon" aria-hidden="true">
                      <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M17 10c0 4-3.5 7-7 7s-7-3-7-7 3.5-7 7-7 7 3 7 7z" stroke="currentColor" stroke-width="1.3"/><path d="M10 7v3l2 2" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </div>
                    <div><span class="nav-mega-title">Consultation</span><span class="nav-mega-desc">Virtual CISO, advisory & incident response</span></div>
                  </a>
                </div>
              </div>
              <a data-name="scramble" href="/software" class={`nav-link nav-link-gradient w-nav-link ${currentPage === 'software' ? 'w--current' : ''}`}>Software</a>
              <a data-name="scramble" href="/updates"  class={`nav-link nav-link-gradient w-nav-link ${currentPage === 'updates'  ? 'w--current' : ''}`}>Updates</a>
              <a data-name="scramble" href="/about"    class={`nav-link nav-link-gradient w-nav-link ${currentPage === 'about'    ? 'w--current' : ''}`}>About</a>
              <a data-name="scramble" href="/blog"     class={`nav-link nav-link-gradient w-nav-link ${currentPage === 'blog'     ? 'w--current' : ''}`}>Blog</a>
              <a data-name="scramble" href="/portal"   class={`nav-link nav-link-gradient w-nav-link ${currentPage === 'portal'   ? 'w--current' : ''}`} style="font-size:0.8em;opacity:0.85;">Client Portal</a>
            </div>
          </nav>
        </div>

        <!-- Desktop CTA -->
        <div class="uw-desktop-cta header-cta-button">
          <div class="button">
            <button type="button" class="button-hidden w-button" data-calendly-open aria-label="Book a call via Calendly">Book a Call</button>
            <div class="button-wrapper"><div class="button-text">Book a Call</div></div>
            <div class="button-accent-gradinet"></div>
          </div>
          <div class="button">
            <a href="/#contact" class="button-hidden w-button">Let's Talk</a>
            <div class="button-wrapper"><div class="button-text">Let's Talk</div></div>
            <div class="button-accent-gradinet"></div>
          </div>
        </div>

        <!-- Mobile hamburger — pure custom, zero Webflow classes -->
        <button
          id="mob-toggle"
          class="mob-toggle"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mob-drawer"
          type="button"
        >
          <span class="mob-bar mob-bar-t"></span>
          <span class="mob-bar mob-bar-m"></span>
          <span class="mob-bar mob-bar-b"></span>
        </button>

      </div>
    </div>
  </div>
</header>

<!-- Noise (kept exactly as original) -->
<div data-wf--noise--variant="base" class="noise-wrapper">
  <div data-w-id="71d94dcc-6696-ef8a-8008-1058c6cb48e2" class="noise"></div>
</div>

<!--
  Mobile drawer — lives here in the source but is teleported to <body>
  by the script below, so position:fixed always uses the real viewport
  (GSAP/Webflow transforms on ancestor elements cannot break it).
-->
<div id="mob-drawer" class="mob-drawer" aria-hidden="true">
  <!-- semi-transparent backdrop -->
  <div class="mob-backdrop" id="mob-backdrop"></div>

  <!-- slide-in panel -->
  <div class="mob-panel" role="dialog" aria-modal="true" aria-label="Navigation">

    <div class="mob-panel-top">
      <a href="/" class="mob-logo">
        <img src="/images/logowhiteUW.png" alt="Underwings" width="120">
      </a>
      <button id="mob-close" class="mob-close" aria-label="Close menu" type="button">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M1 1l14 14M15 1L1 15" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>
    </div>

    <nav class="mob-nav" aria-label="Mobile navigation">
      <span class="mob-label">Services</span>
      <a href="/services/vapt"         class="mob-link">VAPT</a>
      <a href="/services/iso-27001"    class="mob-link">ISO 27001</a>
      <a href="/services/training"     class="mob-link">Training</a>
      <a href="/services/consultation" class="mob-link">Consultation</a>
      <div class="mob-divider"></div>
      <a href="/software" class="mob-link">Software</a>
      <a href="/updates"  class="mob-link">Updates</a>
      <a href="/about"    class="mob-link">About</a>
      <a href="/blog"     class="mob-link">Blog</a>
      <a href="/portal"   class="mob-link mob-link-dim">Client Portal</a>
    </nav>

    <div class="mob-cta">
      <button type="button" class="mob-btn mob-btn-green" data-calendly-open aria-label="Book a call via Calendly">Book a Call</button>
      <a href="/#contact" class="mob-btn mob-btn-outline">Let's Talk</a>
    </div>

  </div>
</div>

<!-- ═══════════════════════════════════════════════════
     STYLES — all prefixed mob-* / completely isolated
═══════════════════════════════════════════════════ -->
<style is:global>

  /* suppress Webflow's own hamburger everywhere */
  .w-nav-button { display: none !important; }

  /* hide desktop pieces on mobile */
  @media (max-width: 991px) {
    .uw-desktop-nav { display: none !important; }
    .uw-desktop-cta { display: none !important; }
    .w-nav-menu     { display: none !important; }
  }

  /* ── tighten the header bar on small screens ─────── */
  @media (max-width: 479px) {
    .navbar {
      padding-top: .625rem !important;
      padding-bottom: .625rem !important;
    }
    /* shrink container side gutters */
    .container-medium.header-container-medium {
      padding-left: .875rem !important;
      padding-right: .875rem !important;
    }
    /* smaller logo */
    .logo {
      height: 1.35rem !important;
    }
  }

  /* ── hamburger button ───────────────────────────── */
  .mob-toggle {
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    padding: 0;
    background: transparent;
    border: 1px dashed rgba(255,255,255,0.35);
    border-radius: 50%;
    cursor: pointer;
    flex-shrink: 0;
    transition: border-color .2s;
    -webkit-tap-highlight-color: transparent;
  }
  @media (max-width: 991px) {
    .mob-toggle { display: flex; }
  }
  @media (max-width: 479px) {
    .mob-toggle { width: 36px; height: 36px; gap: 4px; }
  }
  .mob-toggle:hover { border-color: rgba(255,255,255,.7); }

  .mob-bar {
    display: block;
    width: 16px;
    height: 1.5px;
    border-radius: 2px;
    background: #fff;
    transition: transform .28s ease, opacity .2s ease;
    transform-origin: center center;
  }
  @media (max-width: 479px) {
    .mob-bar { width: 14px; }
  }
  /* X animation */
  .mob-toggle[aria-expanded="true"] .mob-bar-t { transform: translateY(6px)  rotate(45deg);  }
  .mob-toggle[aria-expanded="true"] .mob-bar-m { opacity: 0; transform: scaleX(0);           }
  .mob-toggle[aria-expanded="true"] .mob-bar-b { transform: translateY(-6px) rotate(-45deg); }

  /* ── drawer root (teleported to body by JS) ─────── */
  .mob-drawer {
    display: block;
    visibility: hidden;
    pointer-events: none;
  }
  .mob-drawer.mob-open {
    visibility: visible;
    pointer-events: auto;
  }

  /* ── backdrop ───────────────────────────────────── */
  .mob-backdrop {
    position: fixed;
    inset: 0;
    z-index: 9000;
    background: rgba(0,0,0,.55);
    opacity: 0;
    transition: opacity .3s ease;
  }
  .mob-open .mob-backdrop { opacity: 1; }

  /* ── slide-in panel ─────────────────────────────── */
  .mob-panel {
    position: fixed;
    top: 0;
    right: 0;
    z-index: 9001;
    /* fluid width: 300px on tablet, scales down on phones */
    width: min(300px, 88vw);
    height: 100vh;
    height: 100dvh;
    background: #0d0d0d;
    border-left: 1px solid rgba(255,255,255,.08);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    overscroll-behavior: contain;
    transform: translateX(100%);
    transition: transform .32s cubic-bezier(.4,0,.2,1);
  }
  /* on very small screens take almost full width */
  @media (max-width: 360px) {
    .mob-panel { width: 92vw; }
  }
  .mob-open .mob-panel { transform: translateX(0); }

  /* ── panel top bar ──────────────────────────────── */
  .mob-panel-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: .875rem 1rem;
    border-bottom: 1px solid rgba(255,255,255,.07);
    flex-shrink: 0;
  }
  @media (max-width: 479px) {
    .mob-panel-top { padding: .7rem .875rem; }
  }
  .mob-logo img { display: block; width: 110px; height: auto; }
  @media (max-width: 479px) {
    .mob-logo img { width: 96px; }
  }

  .mob-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    padding: 0;
    background: rgba(255,255,255,.06);
    border: 1px solid rgba(255,255,255,.12);
    border-radius: 7px;
    color: rgba(255,255,255,.7);
    cursor: pointer;
    transition: background .2s, color .2s;
    flex-shrink: 0;
    -webkit-tap-highlight-color: transparent;
  }
  @media (max-width: 479px) {
    .mob-close { width: 30px; height: 30px; border-radius: 6px; }
  }
  .mob-close:hover { background: rgba(255,255,255,.12); color: #fff; }

  /* ── nav links ──────────────────────────────────── */
  .mob-nav {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: .625rem .5rem;
    gap: 1px;
    overflow-y: auto;
  }
  @media (max-width: 479px) {
    .mob-nav { padding: .5rem .375rem; }
  }

  .mob-label {
    display: block;
    padding: .45rem .625rem .25rem;
    font-size: .6rem;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: rgba(255,255,255,.3);
  }

  .mob-link {
    display: block;
    padding: .55rem .75rem;
    font-size: .9375rem;
    font-weight: 500;
    color: rgba(255,255,255,.78);
    text-decoration: none;
    border-radius: 7px;
    transition: background .15s, color .15s;
    -webkit-tap-highlight-color: transparent;
  }
  @media (max-width: 479px) {
    .mob-link { padding: .5rem .625rem; font-size: .875rem; }
  }
  .mob-link:hover,
  .mob-link:focus-visible { background: rgba(255,255,255,.06); color: #fff; outline: none; }
  .mob-link-dim { color: rgba(255,255,255,.35); font-size: .85rem; }
  @media (max-width: 479px) {
    .mob-link-dim { font-size: .8rem; }
  }
  .mob-divider { height: 1px; background: rgba(255,255,255,.07); margin: .4rem 0; }

  /* ── CTA buttons ────────────────────────────────── */
  .mob-cta {
    display: flex;
    flex-direction: column;
    gap: .5rem;
    padding: .75rem .75rem 2rem;
    border-top: 1px solid rgba(255,255,255,.07);
    flex-shrink: 0;
  }
  @media (max-width: 479px) {
    .mob-cta { padding: .625rem .625rem 1.5rem; gap: .4rem; }
  }

  .mob-btn {
    display: block;
    text-align: center;
    text-decoration: none;
    font-size: .9rem;
    font-weight: 600;
    padding: .7rem 1rem;
    border-radius: 8px;
    transition: opacity .2s;
    -webkit-tap-highlight-color: transparent;
    border: none;
    cursor: pointer;
    font-family: inherit;
    width: 100%;
  }
  @media (max-width: 479px) {
    .mob-btn { font-size: .825rem; padding: .6rem .875rem; border-radius: 7px; }
  }
  .mob-btn:hover { opacity: .85; }
  .mob-btn-green   { background: #24d758; color: #000; }
  .mob-btn-outline {
    background: transparent;
    color: rgba(255,255,255,.8);
    border: 1px solid rgba(255,255,255,.18);
  }

</style>

<!-- ═══════════════════════════════════════════════════
     SCRIPT
     • Teleports #mob-drawer to <body> immediately so
       position:fixed is always viewport-relative and
       cannot be broken by GSAP / Webflow transforms.
     • No Webflow, no jQuery dependencies.
═══════════════════════════════════════════════════ -->
<script is:inline nonce={nonce}>
(function () {
  function init() {
    var toggle   = document.getElementById('mob-toggle');
    var drawer   = document.getElementById('mob-drawer');
    var backdrop = document.getElementById('mob-backdrop');
    var closeBtn = document.getElementById('mob-close');

    if (!toggle || !drawer || !backdrop || !closeBtn) {
      return;
    }

    /* ── TELEPORT: move drawer to <body> ───────────────
       Escapes every transformed / filtered ancestor so
       position:fixed uses the real viewport.            */
    document.body.appendChild(drawer);

    var open = false;

    function openMenu() {
      open = true;
      drawer.classList.add('mob-open');
      drawer.setAttribute('aria-hidden', 'false');
      toggle.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      setTimeout(function () { closeBtn.focus(); }, 40);
    }

    function closeMenu() {
      open = false;
      drawer.classList.remove('mob-open');
      drawer.setAttribute('aria-hidden', 'true');
      toggle.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      toggle.focus();
    }

    toggle.addEventListener('click', function () {
      open ? closeMenu() : openMenu();
    });

    closeBtn.addEventListener('click', closeMenu);
    backdrop.addEventListener('click', closeMenu);

    drawer.querySelectorAll('a').forEach(function (a) {
      a.addEventListener('click', closeMenu);
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && open) closeMenu();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
}());
</script>
