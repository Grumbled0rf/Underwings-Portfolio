---
// ===========================================
// HEADER COMPONENT
// Underwings Cybersecurity Solutions
// ===========================================

export interface Props {
  currentPage?: string;
}

const { currentPage = 'home' } = Astro.props;
---

<a href="#main" class="skip-to-content">Skip to content</a>
<header id="header" class="header">
  <div data-w-id="293a7602-a449-8edb-a1a4-0201d537e62c" class="header-offset"></div>
  <div data-w-id="c0f57989-f5a9-9c1a-60c9-2841a4ab0ea2" data-animation="default" data-collapse="medium" data-duration="400" data-easing="ease" data-easing2="ease" role="banner" class="navbar w-nav">
    <div class="container-medium header-container-medium w-container">
      <div class="navbar-inner">
        <a href="/" aria-current={currentPage === 'home' ? 'page' : undefined} class={`logo w-nav-brand ${currentPage === 'home' ? 'w--current' : ''}`}>
          <img src="/images/logowhiteUW.png" loading="lazy" alt="Underwings Cybersecurity Solutions" srcset="/images/logowhiteUW-p-500.png 500w, /images/logowhiteUW.png 639w" sizes="150px" class="logo-image">
        </a>

        <!-- Desktop nav (hidden on mobile via CSS) -->
        <div class="nav-menu-box uw-desktop-nav">
          <nav role="navigation" aria-label="Main navigation" class="nav-menu w-nav-menu">
            <div class="nav-menu-inner">
              <div class="nav-dropdown nav-mega-dropdown">
                <a data-name="scramble" href="#" aria-expanded="false" aria-haspopup="true" class={`nav-link nav-link-gradient w-nav-link ${currentPage === 'services' ? 'w--current' : ''}`}>
                  Services
                  <svg class="nav-chevron" width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
                <div class="nav-mega-content" role="menu" aria-label="Services submenu">
                  <a href="/services/vapt" class="nav-mega-item" role="menuitem">
                    <div class="nav-mega-icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M10 18s6.5-3 6.5-8V5L10 2 3.5 5v5c0 5 6.5 8 6.5 8z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/></svg></div>
                    <div><span class="nav-mega-title">VAPT</span><span class="nav-mega-desc">Penetration testing & vulnerability assessment</span></div>
                  </a>
                  <a href="/services/iso-27001" class="nav-mega-item" role="menuitem">
                    <div class="nav-mega-icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M10 2l2.5 5h5.5l-4.5 3.5 1.5 5.5L10 13l-5 3 1.5-5.5L2 7h5.5L10 2z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/></svg></div>
                    <div><span class="nav-mega-title">ISO 27001</span><span class="nav-mega-desc">Compliance implementation & certification</span></div>
                  </a>
                  <a href="/services/training" class="nav-mega-item" role="menuitem">
                    <div class="nav-mega-icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M10 12l7-4-7-4-7 4 7 4z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/><path d="M17 8v5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/><path d="M5 10v4c0 1.1 2.2 2 5 2s5-.9 5-2v-4" stroke="currentColor" stroke-width="1.3"/></svg></div>
                    <div><span class="nav-mega-title">Training</span><span class="nav-mega-desc">Security awareness & phishing simulations</span></div>
                  </a>
                  <a href="/services/consultation" class="nav-mega-item" role="menuitem">
                    <div class="nav-mega-icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M17 10c0 4-3.5 7-7 7s-7-3-7-7 3.5-7 7-7 7 3 7 7z" stroke="currentColor" stroke-width="1.3"/><path d="M10 7v3l2 2" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
                    <div><span class="nav-mega-title">Consultation</span><span class="nav-mega-desc">Virtual CISO, advisory & incident response</span></div>
                  </a>
                </div>
              </div>
              <a data-name="scramble" href="/software" class={`nav-link nav-link-gradient w-nav-link ${currentPage === 'software' ? 'w--current' : ''}`}>Software</a>
              <a data-name="scramble" href="/updates" class={`nav-link nav-link-gradient w-nav-link ${currentPage === 'updates' ? 'w--current' : ''}`}>Updates</a>
              <a data-name="scramble" href="/about" class={`nav-link nav-link-gradient w-nav-link ${currentPage === 'about' ? 'w--current' : ''}`}>About</a>
              <a data-name="scramble" href="/blog" class={`nav-link nav-link-gradient w-nav-link ${currentPage === 'blog' ? 'w--current' : ''}`}>Blog</a>
              <a data-name="scramble" href="/portal" class={`nav-link nav-link-gradient w-nav-link ${currentPage === 'portal' ? 'w--current' : ''}`} style="font-size:0.8em;opacity:0.85;">Client Portal</a>
            </div>
          </nav>
        </div>

        <!-- Desktop CTA buttons -->
        <div class="header-cta-button" style="display: flex; align-items: center; gap: 0.6rem;">
          <div class="button">
            <a href="#" class="button-hidden w-button" data-calendly-open>Book a Call</a>
            <div class="button-wrapper"><div class="button-text">Book a Call</div></div>
            <div class="button-accent-gradinet"></div>
          </div>
          <div class="button">
            <a href="/#contact" class="button-hidden w-button">Let's Talk</a>
            <div class="button-wrapper"><div class="button-text">Let's Talk</div></div>
            <div class="button-accent-gradinet"></div>
          </div>
        </div>

        <!-- Mobile hamburger (custom) -->
        <button class="uw-mobile-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="uw-mobile-drawer">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </div>
  </div>
</header>

<!-- Mobile drawer overlay -->
<div id="uw-mobile-drawer" class="uw-drawer" role="dialog" aria-modal="true" aria-label="Navigation menu">
  <div class="uw-drawer-header">
    <a href="/" class="uw-drawer-logo">
      <img src="/images/logowhiteUW.png" alt="Underwings" width="130">
    </a>
    <button class="uw-drawer-close" aria-label="Close menu">
      <svg width="22" height="22" viewBox="0 0 22 22" fill="none">
        <path d="M2 2l18 18M20 2L2 20" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  <nav class="uw-drawer-nav">
    <span class="uw-drawer-label">Services</span>
    <a href="/services/vapt" class="uw-drawer-link">VAPT</a>
    <a href="/services/iso-27001" class="uw-drawer-link">ISO 27001</a>
    <a href="/services/training" class="uw-drawer-link">Training</a>
    <a href="/services/consultation" class="uw-drawer-link">Consultation</a>

    <div class="uw-drawer-divider"></div>

    <a href="/software" class="uw-drawer-link">Software</a>
    <a href="/updates" class="uw-drawer-link">Updates</a>
    <a href="/about" class="uw-drawer-link">About</a>
    <a href="/blog" class="uw-drawer-link">Blog</a>
    <a href="/portal" class="uw-drawer-link uw-drawer-link--dim">Client Portal</a>
  </nav>

  <div class="uw-drawer-cta">
    <a href="#" class="uw-drawer-btn uw-drawer-btn--primary" data-calendly-open>Book a Call</a>
    <a href="/#contact" class="uw-drawer-btn uw-drawer-btn--secondary">Let's Talk</a>
  </div>
</div>

<!-- Backdrop -->
<div id="uw-drawer-backdrop" class="uw-drawer-backdrop"></div>

<div data-wf--noise--variant="base" class="noise-wrapper">
  <div data-w-id="71d94dcc-6696-ef8a-8008-1058c6cb48e2" class="noise"></div>
</div>

<style is:global>
  /* ── Hide Webflow's hamburger on mobile ── */
  @media (max-width: 991px) {
    .menu-button.w-nav-button { display: none !important; }
    .uw-desktop-nav { display: none !important; }
    .header-cta-button { display: none !important; }
  }
  @media (min-width: 992px) {
    .uw-mobile-toggle { display: none !important; }
    .uw-drawer { display: none !important; }
    .uw-drawer-backdrop { display: none !important; }
  }

  /* ── Hamburger button ── */
  .uw-mobile-toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px;
    z-index: 1001;
  }
  .uw-mobile-toggle span {
    display: block;
    width: 24px;
    height: 2px;
    background: #fff;
    border-radius: 2px;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }
  .uw-mobile-toggle.is-open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .uw-mobile-toggle.is-open span:nth-child(2) { opacity: 0; }
  .uw-mobile-toggle.is-open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* ── Backdrop ── */
  .uw-drawer-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.6);
    z-index: 1099;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  .uw-drawer-backdrop.is-open {
    opacity: 1;
    pointer-events: all;
  }

  /* ── Drawer panel ── */
  .uw-drawer {
    position: fixed;
    top: 0;
    right: 0;
    width: min(360px, 88vw);
    height: 100vh;
    background: #0d0d0d;
    border-left: 1px solid rgba(255,255,255,0.07);
    z-index: 1100;
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    overflow-y: auto;
  }
  .uw-drawer.is-open {
    transform: translateX(0);
  }

  /* ── Drawer header ── */
  .uw-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid rgba(255,255,255,0.07);
    flex-shrink: 0;
  }
  .uw-drawer-logo img { display: block; }
  .uw-drawer-close {
    background: none;
    border: none;
    color: rgba(255,255,255,0.6);
    cursor: pointer;
    padding: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s;
  }
  .uw-drawer-close:hover { color: #fff; }

  /* ── Nav links ── */
  .uw-drawer-nav {
    flex: 1;
    padding: 1.5rem 1.5rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .uw-drawer-label {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: rgba(255,255,255,0.3);
    padding: 0.25rem 0.75rem 0.5rem;
  }
  .uw-drawer-link {
    font-size: 1.05rem;
    font-weight: 500;
    color: rgba(255,255,255,0.8);
    text-decoration: none;
    padding: 0.7rem 0.75rem;
    border-radius: 8px;
    transition: background 0.18s, color 0.18s;
  }
  .uw-drawer-link:hover,
  .uw-drawer-link:active {
    background: rgba(255,255,255,0.05);
    color: #fff;
  }
  .uw-drawer-link--dim {
    font-size: 0.9rem;
    color: rgba(255,255,255,0.45);
  }
  .uw-drawer-divider {
    height: 1px;
    background: rgba(255,255,255,0.07);
    margin: 0.75rem 0;
  }

  /* ── CTA buttons ── */
  .uw-drawer-cta {
    padding: 1rem 1.5rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    flex-shrink: 0;
    border-top: 1px solid rgba(255,255,255,0.07);
  }
  .uw-drawer-btn {
    display: block;
    text-align: center;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 600;
    padding: 0.85rem 1rem;
    border-radius: 8px;
    transition: opacity 0.2s;
  }
  .uw-drawer-btn:active { opacity: 0.8; }
  .uw-drawer-btn--primary {
    background: #24d758;
    color: #000;
  }
  .uw-drawer-btn--secondary {
    background: rgba(255,255,255,0.06);
    color: #fff;
    border: 1px solid rgba(255,255,255,0.12);
  }
</style>

<script is:inline>
  (function() {
    function initDrawer() {
      var toggle   = document.querySelector('.uw-mobile-toggle');
      var drawer   = document.getElementById('uw-mobile-drawer');
      var backdrop = document.getElementById('uw-drawer-backdrop');
      var closeBtn = drawer && drawer.querySelector('.uw-drawer-close');

      if (!toggle || !drawer || !backdrop || !closeBtn) return;

      function openDrawer() {
        drawer.classList.add('is-open');
        backdrop.classList.add('is-open');
        toggle.classList.add('is-open');
        toggle.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
      }
      function closeDrawer() {
        drawer.classList.remove('is-open');
        backdrop.classList.remove('is-open');
        toggle.classList.remove('is-open');
        toggle.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
      }

      toggle.addEventListener('click', function() {
        drawer.classList.contains('is-open') ? closeDrawer() : openDrawer();
      });
      closeBtn.addEventListener('click', closeDrawer);
      backdrop.addEventListener('click', closeDrawer);

      drawer.querySelectorAll('.uw-drawer-link, .uw-drawer-btn').forEach(function(el) {
        el.addEventListener('click', closeDrawer);
      });

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closeDrawer();
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initDrawer);
    } else {
      initDrawer();
    }
  })();
</script>
