{
  "id": "uw-outbound-send-v1",
  "name": "16 - Outbound send (approved drafts)",
  "active": false,
  "nodes": [
    {
      "id": "notes",
      "name": "Notes — read this first",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [180, 60],
      "parameters": {
        "content": "## 16 — Outbound send (approved drafts)\nWeekdays 09:00 Asia/Dubai. POSTs /outbound/send, which sends ONLY\nstatus='approved' email drafts, newest-scored first, ≤25/day/mailbox,\nlogs uw_outbound_log, marks drafts sent.\n\n### Safe by design\nThe sidecar REFUSES to send unless OUTBOUND_SMTP_USER/PASS + OUTBOUND_FROM\nare set (dedicated outreach domain — Phase H). Until then this is a no-op\nthat returns an explanatory error. So activating it early can't blast the\nmain domain. Keep INACTIVE until the warmed domain + creds exist.\nSpec: docs/superpowers/specs/2026-05-27-outbound-free-oss.md"
      }
    },
    {
      "id": "cron",
      "name": "Cron: weekdays 09:00 Asia/Dubai",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [180, 360],
      "parameters": {
        "rule": { "interval": [ { "field": "cronExpression", "expression": "0 9 * * 1-5" } ] }
      }
    },
    {
      "id": "send",
      "name": "Sidecar /outbound/send",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 360],
      "parameters": {
        "method": "POST",
        "url": "http://pandoc-render:3000/outbound/send",
        "sendHeaders": true,
        "headerParameters": { "parameters": [
          { "name": "Content-Type", "value": "application/json" },
          { "name": "X-Shared-Token", "value": "={{ $env.PANDOC_RENDER_TOKEN }}" }
        ] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ dry_run: false }) }}",
        "options": { "timeout": 120000, "response": { "response": { "responseFormat": "json" } }, "ignoreHttpStatusErrors": true }
      }
    },
    {
      "id": "branch-ok",
      "name": "Sent ok?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [700, 360],
      "parameters": {
        "conditions": {
          "options": { "version": 2, "looseTypeValidation": true },
          "conditions": [ { "leftValue": "={{ String($json.ok) }}", "rightValue": "true", "operator": { "type": "string", "operation": "equals" } } ],
          "combinator": "and"
        },
        "options": { "looseTypeValidation": true }
      }
    },
    {
      "id": "slack-ok",
      "name": "Slack: #sales-pipeline sent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 260],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SLACK_SALES_WEBHOOK }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: `📤 Outbound send: ${$json.sent} email(s) sent (cap ${$json.cap_per_mailbox}/mailbox, capped ${$json.capped}, failed ${$json.failed}).` }) }}",
        "options": { "ignoreHttpStatusErrors": true }
      }
    },
    {
      "id": "slack-halt",
      "name": "Slack: #sales-pipeline halt",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 460],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SLACK_SALES_WEBHOOK }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: `⚠️ Outbound send not run — ${$json.reason || ('step: ' + $json.step)}` }) }}",
        "options": { "ignoreHttpStatusErrors": true }
      }
    }
  ],
  "connections": {
    "Cron: weekdays 09:00 Asia/Dubai": { "main": [ [ { "node": "Sidecar /outbound/send", "type": "main", "index": 0 } ] ] },
    "Sidecar /outbound/send": { "main": [ [ { "node": "Sent ok?", "type": "main", "index": 0 } ] ] },
    "Sent ok?": { "main": [ [ { "node": "Slack: #sales-pipeline sent", "type": "main", "index": 0 } ], [ { "node": "Slack: #sales-pipeline halt", "type": "main", "index": 0 } ] ] }
  },
  "settings": { "executionOrder": "v1" }
}
