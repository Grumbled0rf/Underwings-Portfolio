{
  "id": "uw-proposal-generator-v1",
  "name": "07 - Proposal generator (Scoping → Proposal Sent)",
  "active": false,
  "nodes": [
    {
      "id": "notes",
      "name": "Notes — read this first",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [200, 80],
      "parameters": {
        "content": "## What this does (v2 — sidecar architecture)\nAll heavy lifting moved to the pandoc-render sidecar's POST /proposal\nendpoint. This workflow is now just: form → HTTP → branch → Slack.\n\nThe sidecar (one call) does: Krayin lead fetch, template load, Claude\ndraft, JSON validation, PDF render, Documenso envelope create, Krayin\nstage → Proposal Sent, Claude cost logging to the warehouse.\n\nWhy: the old 16-node per-step workflow hit 10+ n8n version quirks.\nSee feedback_n8n_workflow_fragility memory + spec\ndocs/superpowers/specs/2026-05-23-workflow-07-rewrite.md.\n\n## Trigger\nn8n form at /form/proposal-generator (fill after a discovery call).\n\n## Sidecar response\n{ ok: true, proposal_ref, total_aed, documenso_envelope_id, ... }\nor { ok: false, step, reason, missing_info? }\n\n## Halt cases (ok:false)\n- scope_notes < 100 chars\n- Claude needs_more_info\n- price/validation failure\nAll routed to the Slack halt-notice branch.\n\n## KPI\nProposal generated < 2h after scoping call ends."
      }
    },
    {
      "id": "form-trigger",
      "name": "Form: post-discovery scoping",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2,
      "position": [200, 360],
      "webhookId": "proposal-generator-form",
      "parameters": {
        "path": "proposal-generator",
        "formTitle": "Generate a proposal",
        "formDescription": "Fill this after your discovery call to generate a Documenso-signable proposal.",
        "formFields": {
          "values": [
            { "fieldLabel": "Krayin lead ID", "fieldType": "number", "requiredField": true },
            { "fieldLabel": "SKU", "fieldType": "dropdown", "requiredField": true, "fieldOptions": { "values": [
              { "option": "pen-test-web" },
              { "option": "pen-test-network-external" },
              { "option": "pen-test-network-internal" },
              { "option": "pen-test-mobile" },
              { "option": "phishing-simulation" },
              { "option": "iso-27001-implementation" },
              { "option": "adhics-readiness" },
              { "option": "pdpl-implementation" },
              { "option": "ptaas-subscription" },
              { "option": "continuous-compliance" },
              { "option": "software-resale-generic" }
            ] }},
            { "fieldLabel": "Scope notes (everything from the call, freeform)", "fieldType": "textarea", "requiredField": true, "placeholder": "Their context, worries, deadlines, systems in scope, integrations, regulators. Minimum 100 chars." }
          ]
        },
        "options": { "appendAttribution": false }
      }
    },
    {
      "id": "call-sidecar",
      "name": "Call pandoc-render /proposal",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 360],
      "parameters": {
        "method": "POST",
        "url": "http://pandoc-render:3000/proposal",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type",   "value": "application/json" },
            { "name": "X-Shared-Token", "value": "={{ $env.PANDOC_RENDER_TOKEN }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ lead_id: $json['Krayin lead ID'], sku: $json['SKU'], scope_notes: $json['Scope notes (everything from the call, freeform)'] }) }}",
        "options": {
          "timeout": 60000,
          "response": { "response": { "responseFormat": "json" } },
          "ignoreHttpStatusErrors": true
        }
      }
    },
    {
      "id": "branch-ok",
      "name": "Sidecar succeeded?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [720, 360],
      "parameters": {
        "conditions": {
          "options": { "version": 2, "looseTypeValidation": true },
          "conditions": [
            { "leftValue": "={{ String($json.ok) }}", "rightValue": "true", "operator": { "type": "string", "operation": "equals" } }
          ],
          "combinator": "and"
        },
        "options": { "looseTypeValidation": true }
      }
    },
    {
      "id": "slack-announce",
      "name": "Slack: #sales-pipeline announce",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [980, 260],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SLACK_SALES_WEBHOOK }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: `📄 Proposal *${$json.proposal_ref}* sent to *${$json.client_company || 'client'}* — AED ${$json.total_aed} — Documenso: ${$json.documenso_status}` }) }}",
        "options": { "ignoreHttpStatusErrors": true }
      }
    },
    {
      "id": "slack-halt",
      "name": "Slack: #sales-pipeline halt notice",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [980, 460],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SLACK_SALES_WEBHOOK }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: `⚠️ Proposal NOT generated — step: ${$json.step}, reason: ${$json.reason}${$json.missing_info ? ' — missing: ' + $json.missing_info.join(', ') : ''}` }) }}",
        "options": { "ignoreHttpStatusErrors": true }
      }
    }
  ],
  "connections": {
    "Form: post-discovery scoping":   { "main": [[{ "node": "Call pandoc-render /proposal", "type": "main", "index": 0 }]] },
    "Call pandoc-render /proposal":   { "main": [[{ "node": "Sidecar succeeded?", "type": "main", "index": 0 }]] },
    "Sidecar succeeded?":             { "main": [
      [{ "node": "Slack: #sales-pipeline announce",     "type": "main", "index": 0 }],
      [{ "node": "Slack: #sales-pipeline halt notice",  "type": "main", "index": 0 }]
    ]}
  },
  "settings": {
    "executionOrder": "v1",
    "saveExecutionProgress": true,
    "saveManualExecutions": true
  },
  "versionId": "v2-2026-05-26"
}
