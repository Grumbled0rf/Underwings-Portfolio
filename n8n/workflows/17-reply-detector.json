{
  "id": "uw-outbound-reply-detector-v1",
  "name": "17 - Outbound reply detector",
  "active": false,
  "nodes": [
    {
      "id": "notes",
      "name": "Notes — read this first",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [180, 60],
      "parameters": {
        "content": "## 17 — Outbound reply detector\nIMAP trigger on the outreach mailbox -> extract {from,subject,body} ->\nPOST /outbound/reply. Claude classifies the reply and the sidecar acts:\n  interested -> Krayin MQL (14) + #hot-leads ping\n  never      -> add to suppression list\n  not_now/ooo/unknown -> record only.\n\n### Requires (Phase H)\nCreate an n8n IMAP credential named 'Outreach IMAP' for the\noutreach@outreach.underwings.org mailbox (host mail.underwings.org, 993,\nTLS). Until then this stays INACTIVE.\nSpec: docs/superpowers/specs/2026-05-27-outbound-free-oss.md"
      }
    },
    {
      "id": "imap",
      "name": "IMAP: outreach mailbox",
      "type": "n8n-nodes-base.emailReadImap",
      "typeVersion": 2,
      "position": [180, 360],
      "parameters": {
        "format": "simple",
        "options": {}
      },
      "credentials": {
        "imap": { "id": "outreach-imap", "name": "Outreach IMAP (outreach.underwings.org)" }
      }
    },
    {
      "id": "extract",
      "name": "Extract from / subject / body",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 360],
      "parameters": {
        "jsCode": "const j = $input.item.json;\nfunction addr(s){ const m = String(s||'').match(/<([^>]+)>/); return (m ? m[1] : String(s||'')).trim().toLowerCase(); }\nreturn { json: {\n  from: addr(j.from),\n  subject: j.subject || '',\n  body: j.textPlain || j.text || j.textHtml || ''\n} };"
      }
    },
    {
      "id": "reply",
      "name": "Sidecar /outbound/reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 360],
      "parameters": {
        "method": "POST",
        "url": "http://pandoc-render:3000/outbound/reply",
        "sendHeaders": true,
        "headerParameters": { "parameters": [
          { "name": "Content-Type", "value": "application/json" },
          { "name": "X-Shared-Token", "value": "={{ $env.PANDOC_RENDER_TOKEN }}" }
        ] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ from: $json.from, subject: $json.subject, body: $json.body }) }}",
        "options": { "timeout": 60000, "response": { "response": { "responseFormat": "json" } }, "ignoreHttpStatusErrors": true }
      }
    }
  ],
  "connections": {
    "IMAP: outreach mailbox": { "main": [ [ { "node": "Extract from / subject / body", "type": "main", "index": 0 } ] ] },
    "Extract from / subject / body": { "main": [ [ { "node": "Sidecar /outbound/reply", "type": "main", "index": 0 } ] ] }
  },
  "settings": { "executionOrder": "v1" }
}
