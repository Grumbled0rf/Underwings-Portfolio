{
  "id": "uw-enrichment-sweep-v1",
  "name": "03 - Enrichment Sweep (every 5 min)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "minutes", "minutesInterval": 5 }
          ]
        }
      },
      "id": "bbbbbbb1-0000-0000-0000-000000000001",
      "name": "Cron: every 5 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://krayin/webhook-leads-needing-enrichment.php?max=20&max_age_hours=48",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Webhook-Token", "value": "={{ $env.KRAYIN_WEBHOOK_TOKEN }}" }
          ]
        },
        "options": {
          "timeout": 15000,
          "response": { "response": { "fullResponse": false, "responseFormat": "json" } }
        }
      },
      "id": "bbbbbbb2-0000-0000-0000-000000000002",
      "name": "Fetch unscored leads",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "jsCode": "// Fan out: emit one item per lead the sweep should enrich\nconst resp = $input.first().json;\nconst leads = Array.isArray(resp?.leads) ? resp.leads : [];\nreturn leads.map(lead => ({ json: lead }));"
      },
      "id": "bbbbbbb3-0000-0000-0000-000000000003",
      "name": "Split per lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:5678/webhook/enrich-lead",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type",   "value": "application/json" },
            { "name": "X-Inbound-Token","value": "={{ $env.INBOUND_WEBHOOK_TOKEN }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 60000,
          "batching": { "batch": { "batchSize": 1, "batchInterval": 1500 } },
          "response": { "response": { "fullResponse": false, "neverError": true } }
        }
      },
      "id": "bbbbbbb4-0000-0000-0000-000000000004",
      "name": "Trigger enrichment per lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300],
      "continueOnFail": true
    }
  ],
  "connections": {
    "Cron: every 5 min": {
      "main": [[{ "node": "Fetch unscored leads", "type": "main", "index": 0 }]]
    },
    "Fetch unscored leads": {
      "main": [[{ "node": "Split per lead", "type": "main", "index": 0 }]]
    },
    "Split per lead": {
      "main": [[{ "node": "Trigger enrichment per lead", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveExecutionProgress": true,
    "saveManualExecutions": true,
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all"
  },
  "active": false,
  "pinData": {},
  "tags": [
    { "name": "phase-2-5" },
    { "name": "cron" },
    { "name": "enrichment" }
  ]
}
