{
  "id": "uw-outbound-discover-harvest-v1",
  "name": "15 - Outbound discover + harvest (free)",
  "active": false,
  "nodes": [
    {
      "id": "notes",
      "name": "Notes — read this first",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [180, 60],
      "parameters": {
        "content": "## 15 — Outbound discover + harvest (FREE variant)\nDaily 07:00 Asia/Dubai. Thin wrapper over the sidecar:\n  /outbound/discover (OSM + website scrape)  ->  /outbound/harvest\n  (Claude score >=60 -> draft -> uw_outbound_draft review queue).\n\nSends NOTHING. Drafts wait for human approval, then workflow 16 sends.\n\n### This is a TEMPLATE — clone per practitioner/ICP\nThe Discover node is configured for manoj + OSM hospitals. Duplicate the\nDiscover+Harvest pair (or change the body) for nelson/vinoth and other\ncategories (clinic, factory, ...) or mode 'search' (needs GOOGLE_CSE_*).\n\n### Gated\nKeep INACTIVE until Phase H (warmed outreach domain) is ready, OR activate\njust to populate the review queue (costs a little Claude, sends nothing).\nSpec: docs/superpowers/specs/2026-05-27-outbound-free-oss.md"
      }
    },
    {
      "id": "cron",
      "name": "Cron: 07:00 Asia/Dubai daily",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [180, 360],
      "parameters": {
        "rule": { "interval": [ { "field": "cronExpression", "expression": "0 7 * * *" } ] }
      }
    },
    {
      "id": "discover",
      "name": "Discover (OSM)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 360],
      "parameters": {
        "method": "POST",
        "url": "http://pandoc-render:3000/outbound/discover",
        "sendHeaders": true,
        "headerParameters": { "parameters": [
          { "name": "Content-Type", "value": "application/json" },
          { "name": "X-Shared-Token", "value": "={{ $env.PANDOC_RENDER_TOKEN }}" }
        ] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ practitioner: 'manoj', mode: 'osm', query: { category: 'hospital' }, limit: 25 }) }}",
        "options": { "timeout": 90000, "response": { "response": { "responseFormat": "json" } }, "ignoreHttpStatusErrors": true }
      }
    },
    {
      "id": "harvest",
      "name": "Harvest (Claude score + draft)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 360],
      "parameters": {
        "method": "POST",
        "url": "http://pandoc-render:3000/outbound/harvest",
        "sendHeaders": true,
        "headerParameters": { "parameters": [
          { "name": "Content-Type", "value": "application/json" },
          { "name": "X-Shared-Token", "value": "={{ $env.PANDOC_RENDER_TOKEN }}" }
        ] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ practitioner: 'manoj', source: 'osm', limit: 10, candidates: $json.candidates }) }}",
        "options": { "timeout": 120000, "response": { "response": { "responseFormat": "json" } }, "ignoreHttpStatusErrors": true }
      }
    },
    {
      "id": "branch-ok",
      "name": "Harvest ok?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [960, 360],
      "parameters": {
        "conditions": {
          "options": { "version": 2, "looseTypeValidation": true },
          "conditions": [ { "leftValue": "={{ String($json.ok) }}", "rightValue": "true", "operator": { "type": "string", "operation": "equals" } } ],
          "combinator": "and"
        },
        "options": { "looseTypeValidation": true }
      }
    },
    {
      "id": "slack-ok",
      "name": "Slack: #sales-pipeline summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1220, 260],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SLACK_SALES_WEBHOOK }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: `🧲 Outbound discover+harvest: ${$json.drafted} new draft(s) queued for review (harvested ${$json.harvested}, skipped ${$json.skipped_low_score} low-score). Approve in the queue, then wf16 sends.` }) }}",
        "options": { "ignoreHttpStatusErrors": true }
      }
    },
    {
      "id": "slack-halt",
      "name": "Slack: #sales-pipeline halt",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1220, 460],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SLACK_SALES_WEBHOOK }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: `⚠️ Outbound discover/harvest failed — step: ${$json.step}, reason: ${$json.reason}` }) }}",
        "options": { "ignoreHttpStatusErrors": true }
      }
    }
  ],
  "connections": {
    "Cron: 07:00 Asia/Dubai daily": { "main": [ [ { "node": "Discover (OSM)", "type": "main", "index": 0 } ] ] },
    "Discover (OSM)": { "main": [ [ { "node": "Harvest (Claude score + draft)", "type": "main", "index": 0 } ] ] },
    "Harvest (Claude score + draft)": { "main": [ [ { "node": "Harvest ok?", "type": "main", "index": 0 } ] ] },
    "Harvest ok?": { "main": [ [ { "node": "Slack: #sales-pipeline summary", "type": "main", "index": 0 } ], [ { "node": "Slack: #sales-pipeline halt", "type": "main", "index": 0 } ] ] }
  },
  "settings": { "executionOrder": "v1" }
}
