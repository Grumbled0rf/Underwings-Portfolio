{
  "id": "uw-outbound-linkedin-queue-v1",
  "name": "18 - LinkedIn human-send queue",
  "active": false,
  "nodes": [
    {
      "id": "notes",
      "name": "Notes — read this first",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [180, 60],
      "parameters": {
        "content": "## 18 — LinkedIn human-send queue\nLinkedIn is NEVER automated (ToS + our own PDPL posture). This workflow has\ntwo independent chains:\n\n1. DIGEST (cron, weekdays 09:30 Asia/Dubai): POST /outbound/linkedin-queue —\n   the sidecar posts approved drafts that have a DM (and aren't yet sent) to\n   each practitioner's #hot-leads, with the profile link + the drafted DM.\n   You send each one by hand on LinkedIn.\n\n2. MARK SENT (form): after sending, open the form and paste the draft IDs\n   (comma-separated). POST /outbound/linkedin-sent logs them so they drop\n   out of tomorrow's digest.\n\nSafe to activate any time (no auto-send). Slack hot-leads webhooks must be\nset in n8n env. Spec: docs/superpowers/specs/2026-05-27-outbound-free-oss.md"
      }
    },
    {
      "id": "cron",
      "name": "Cron: weekdays 09:30 Asia/Dubai",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [180, 340],
      "parameters": {
        "rule": { "interval": [ { "field": "cronExpression", "expression": "30 9 * * 1-5" } ] }
      }
    },
    {
      "id": "digest",
      "name": "Sidecar /outbound/linkedin-queue",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 340],
      "parameters": {
        "method": "POST",
        "url": "http://pandoc-render:3000/outbound/linkedin-queue",
        "sendHeaders": true,
        "headerParameters": { "parameters": [
          { "name": "Content-Type", "value": "application/json" },
          { "name": "X-Shared-Token", "value": "={{ $env.PANDOC_RENDER_TOKEN }}" }
        ] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({}) }}",
        "options": { "timeout": 60000, "response": { "response": { "responseFormat": "json" } }, "ignoreHttpStatusErrors": true }
      }
    },
    {
      "id": "form",
      "name": "Form: LinkedIn sent",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2,
      "position": [180, 620],
      "webhookId": "outbound-linkedin-sent",
      "parameters": {
        "path": "linkedin-sent",
        "formTitle": "Mark LinkedIn DMs sent",
        "formDescription": "After you have sent the DMs on LinkedIn, paste the draft IDs (comma-separated) to clear them from the queue.",
        "formFields": { "values": [
          { "fieldLabel": "Draft IDs (comma-separated)", "fieldType": "text", "requiredField": true, "placeholder": "e.g. 12, 15, 18" }
        ] },
        "options": { "appendAttribution": false }
      }
    },
    {
      "id": "marksent",
      "name": "Sidecar /outbound/linkedin-sent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 620],
      "parameters": {
        "method": "POST",
        "url": "http://pandoc-render:3000/outbound/linkedin-sent",
        "sendHeaders": true,
        "headerParameters": { "parameters": [
          { "name": "Content-Type", "value": "application/json" },
          { "name": "X-Shared-Token", "value": "={{ $env.PANDOC_RENDER_TOKEN }}" }
        ] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ draft_ids: $json['Draft IDs (comma-separated)'] }) }}",
        "options": { "timeout": 60000, "response": { "response": { "responseFormat": "json" } }, "ignoreHttpStatusErrors": true }
      }
    }
  ],
  "connections": {
    "Cron: weekdays 09:30 Asia/Dubai": { "main": [ [ { "node": "Sidecar /outbound/linkedin-queue", "type": "main", "index": 0 } ] ] },
    "Form: LinkedIn sent": { "main": [ [ { "node": "Sidecar /outbound/linkedin-sent", "type": "main", "index": 0 } ] ] }
  },
  "settings": { "executionOrder": "v1" }
}
